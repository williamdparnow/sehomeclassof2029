            const modal = document.createElement('div');
            modal.className = 'bulk-modal';
            modal.style.display = 'flex';
            modal.innerHTML = `
                <div class="bulk-modal-content">
                    <h3 style="color: #1a5f1a; text-align: center; margin-bottom: 1rem;">⏰ Event Reminder System</h3>
                    <p style="color: #666; text-align: center; margin-bottom: 2rem;">Set up automatic reminders for important class events</p>
                    
                    <form onsubmit="createEventReminder(event, this.parentElement.parentElement)">
