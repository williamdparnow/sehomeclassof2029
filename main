            document.getElementById('sehomeScore').focus();
        }

        function updateGameScore(e, eventId, dateKey, modal, scoringMethod = 'standard') {
            e.preventDefault();
            
            const sehomeScore = parseInt(document.getElementById('sehomeScore').value);
            const opponentScore = parseInt(document.getElementById('opponentScore').value);
            const gameNotes = document.getElementById('gameNotes').value;
            
            // Find and update the event
            const event = events[dateKey].find(e => e.id === eventId);
            if (event) {
                event.score = {
                    sehome: sehomeScore,
                    opponent: opponentScore,
                    notes: gameNotes,
                    updatedAt: new Date().toISOString(),
                    scoringMethod: scoringMethod
                };
                event.status = 'completed';
                
                // Determine win/loss/tie based on scoring method
                let result = '';
                if (scoringMethod === 'cross-country' || scoringMethod === 'golf') {
                    // Lower score wins for cross country and golf
                    if (sehomeScore < opponentScore) {
                        result = 'W';
                    } else if (sehomeScore > opponentScore) {
                        result = 'L';
                    } else {
                        result = 'T';
                    }
                } else {
                    // Higher score wins for all other sports
                    if (sehomeScore > opponentScore) {
                        result = 'W';
                    } else if (sehomeScore < opponentScore) {
                        result = 'L';
                    } else {
                        result = 'T';
                    }
                }
                event.result = result;
                
                localStorage.setItem('sehomeEvents', JSON.stringify(events));
                
                renderCalendar();
                renderEventsList();
                renderAdminEventsList();
                renderPendingGames();
                
                modal.remove();
                
                const sportConfig = SPORTS_CONFIG[event.sportsType] || { name: event.sportsType, emoji: '🏆' };
                const genderText = event.gender ? ` (${event.gender === 'boys' ? 'Boys' : 'Girls'})` : '';
                
                // Create sport-specific score display
                let scoreDisplay = '';
                switch (scoringMethod) {
                    case 'tennis':
                        scoreDisplay = `${sehomeScore}-${opponentScore} matches`;
                        break;
                    case 'cross-country':
                    case 'golf':
                        scoreDisplay = `${sehomeScore}-${opponentScore} ${scoringMethod === 'golf' ? 'strokes' : 'points'}`;
                        break;
                    case 'sets':
                        scoreDisplay = `${sehomeScore}-${opponentScore} sets`;
                        break;
                    case 'wrestling':
                    case 'track':
                        scoreDisplay = `${sehomeScore}-${opponentScore} team points`;
                        break;
                    default:
                        scoreDisplay = `${sehomeScore}-${opponentScore}`;
                }
                
                logAdminActivity(`Updated ${sportConfig.name}${genderText} score: Sehome ${scoreDisplay} (${result})`);
                resetSession();
                
                const resultEmoji = result === 'W' ? '🎉' : result === 'L' ? '😔' : '🤝';
                showNotification(`${resultEmoji} Score updated! Sehome ${scoreDisplay}`);
            }
        }

        function renderAdminEventsList() {
            const eventsList = document.getElementById('eventsList');
            eventsList.innerHTML = '';
            
            const allEvents = [];
            Object.keys(events).forEach(dateKey => {
                events[dateKey].forEach(event => {
                    allEvents.push({
                        ...event,
                        date: dateKey
                    });
                });
            });
            
            allEvents.sort((a, b) => new Date(a.date) - new Date(b.date));
            
            if (allEvents.length === 0) {
                eventsList.innerHTML = '<p style="color: #666; text-align: center; padding: 2rem;">No events created yet.</p>';
                return;
            }
            
            allEvents.forEach(event => {
                const eventCard = document.createElement('div');
                eventCard.className = 'announcement-card';
                eventCard.setAttribute('data-event-id', event.id);
                
                const formattedDate = new Date(event.date).toLocaleDateString('en-US', {
                    weekday: 'long',
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });
                
                // Get category info
                const categoryEmojis = {
                    academic: '📚',
                    social: '🎉',
                    sports: '🏆',
                    club: '🎭',
                    school: '🏫',
                    'spirit-week': '🌟',
                    other: '📝'
                };
                
                const categoryEmoji = categoryEmojis[event.category] || '📝';
                const sportConfig = event.sportsType ? SPORTS_CONFIG[event.sportsType] : null;
                
                let scoreDisplay = '';
                if (event.score) {
                    const resultEmoji = event.result === 'W' ? '🎉' : event.result === 'L' ? '😔' : '🤝';
                    scoreDisplay = `
                        <div style="background: ${event.result === 'W' ? '#e8f5e8' : event.result === 'L' ? '#ffe8e8' : '#f0f0f0'}; padding: 1rem; border-radius: 10px; margin: 1rem 0; border: 2px solid ${event.result === 'W' ? '#1a5f1a' : event.result === 'L' ? '#cc0000' : '#999'};">
                            <strong>${resultEmoji} Final Score:</strong> Sehome ${event.score.sehome} - ${event.opponent || 'Opponent'} ${event.score.opponent}
                            ${event.score.notes ? `<br><em>Notes: ${event.score.notes}</em>` : ''}
                        </div>
                    `;
                }
                
                eventCard.innerHTML = `
                    <div class="card-header">
                        <div class="card-title">${categoryEmoji} ${sportConfig ? sportConfig.emoji + ' ' + sportConfig.name + ' - ' : ''}${event.title}</div>
                        <div class="card-actions">
                            ${event.category === 'sports' && !event.score ? `<button class="action-btn" onclick="showScoreModal(${event.id}, '${event.date}')">📊 Add Score</button>` : ''}
                            <button class="action-btn delete" onclick="deleteEvent(${event.id}, '${event.date}')">🗑️ Delete</button>
                        </div>
                    </div>
                    <p><strong>Date:</strong> ${formattedDate} ${event.time ? `at ${event.time}` : ''}</p>
                    ${event.opponent ? `<p><strong>Opponent:</strong> ${event.opponent}</p>` : ''}
                    ${event.location ? `<p><strong>Location:</strong> ${event.location}</p>` : ''}
                    ${event.description ? `<p>${event.description}</p>` : ''}
                    ${scoreDisplay}
                `;
                
                eventsList.appendChild(eventCard);
            });
        }

        function addAnnouncement(e) {
            e.preventDefault();
            
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            const announcement = {
                id: Date.now(),
                title: document.getElementById('announcementTitle').value,
                content: document.getElementById('announcementContent').value,
                priority: document.getElementById('announcementPriority').value,
                date: new Date().toLocaleDateString()
            };
            
            announcements.unshift(announcement);
            localStorage.setItem('sehomeAnnouncements', JSON.stringify(announcements));
            
            document.getElementById('announcementTitle').value = '';
            document.getElementById('announcementContent').value = '';
            document.getElementById('announcementPriority').value = 'low';
            
            renderAnnouncementsList();
            
            logAdminActivity(`Posted announcement: ${announcement.title}`);
            resetSession();
            showNotification('📢 Announcement posted!');
        }

        function renderAnnouncementsList() {
            const announcementsList = document.getElementById('announcementsList');
            announcementsList.innerHTML = '';
            
            announcements.forEach((announcement, index) => {
                const announcementCard = document.createElement('div');
                announcementCard.className = 'announcement-card flip-in';
                announcementCard.setAttribute('data-announcement-id', announcement.id);
                announcementCard.style.animationDelay = `${index * 0.1}s`;
                
                announcementCard.innerHTML = `
                    <div class="card-header">
                        <div class="card-title">${announcement.title}</div>
                        <div class="card-actions">
                            <span class="action-btn">${announcement.priority.toUpperCase()}</span>
                            <button class="action-btn delete" onclick="deleteAnnouncement(${announcement.id})">🗑️ Delete</button>
                        </div>
                    </div>
                    <p>${announcement.content}</p>
                    <small>Posted: ${announcement.date}</small>
                `;
                
                announcementsList.appendChild(announcementCard);
            });
            
            // Also update public announcements display
            renderPublicAnnouncements();
        }

        function renderPublicAnnouncements() {
            const publicList = document.getElementById('publicAnnouncementsList');
            
            // Remove expired mood boosters
            const now = new Date();
            moodBoosters = moodBoosters.filter(booster => new Date(booster.expires) > now);
            localStorage.setItem('moodBoosters', JSON.stringify(moodBoosters));
            
            // Combine announcements and mood boosters
            const allItems = [];
            
            // Add recent announcements
            announcements.slice(0, 3).forEach(announcement => {
                allItems.push({
                    type: 'announcement',
                    data: announcement,
                    date: new Date(announcement.date)
                });
            });
            
            // Add recent mood boosters
            moodBoosters.slice(0, 2).forEach(booster => {
                allItems.push({
                    type: 'mood-booster',
                    data: booster,
                    date: new Date(booster.date)
                });
            });
            
            // Sort by date (newest first)
            allItems.sort((a, b) => b.date - a.date);
            
            if (allItems.length > 0) {
                publicList.innerHTML = '';
                allItems.slice(0, 4).forEach(item => {
                    if (item.type === 'announcement') {
                        const announcementCard = document.createElement('div');
                        announcementCard.className = 'announcement-card';
                        
                        announcementCard.innerHTML = `
                            <div class="card-title">${item.data.title}</div>
                            <p>${item.data.content}</p>
                            <small>Posted: ${item.data.date}</small>
                        `;
                        
                        publicList.appendChild(announcementCard);
                    } else if (item.type === 'mood-booster') {
                        const moodCard = document.createElement('div');
                        moodCard.className = 'mood-booster-card';
                        
                        moodCard.innerHTML = `
                            <h4>✨ Daily Inspiration</h4>
                            <p>${item.data.message}</p>
                            <small style="color: #666; font-style: italic;">From your Class Representatives</small>
                        `;
                        
                        publicList.appendChild(moodCard);
                    }
                });
            } else {
                publicList.innerHTML = '<div style="color: #666; text-align: center; padding: 2rem; font-style: italic;">📢 No announcements yet. Admins can post updates in the admin panel!</div>';
            }
        }

        function renderSuggestionsList() {
            const suggestionsList = document.getElementById('suggestionsList');
            suggestionsList.innerHTML = '';
            
            if (suggestions.length === 0) {
                suggestionsList.innerHTML = '<p style="color: #666; text-align: center; padding: 2rem;">No suggestions yet.</p>';
                return;
            }
            
            suggestions.forEach((suggestion, index) => {
                const suggestionCard = document.createElement('div');
                suggestionCard.className = 'suggestion-card slide-in-up';
                suggestionCard.setAttribute('data-suggestion-id', suggestion.id);
                suggestionCard.style.animationDelay = `${index * 0.15}s`;
                
                suggestionCard.innerHTML = `
                    <div class="card-header">
                        <div class="card-title">Anonymous Suggestion</div>
                        <div class="card-actions">
                            <button class="action-btn delete" onclick="deleteSuggestion(${suggestion.id})">🗑️ Delete</button>
                        </div>
                    </div>
                    <p>${suggestion.text}</p>
                    <small>Submitted: ${suggestion.date}</small>
                `;
                
                suggestionsList.appendChild(suggestionCard);
            });
        }

        // Class Representative Functions
        function addClassRep(e) {
            e.preventDefault();
            
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            const photoFile = document.getElementById('repPhoto').files[0];
            if (!photoFile) {
                showNotification('Please select a photo file!', 'error');
                return;
            }
            
            // Show photo crop modal
            showPhotoCropModal(photoFile, (croppedImageData) => {
                const rep = {
                    id: Date.now(),
                    name: document.getElementById('repName').value,
                    role: document.getElementById('repRole').value,
                    photo: croppedImageData, // cropped base64 data URL
                    date: new Date().toLocaleDateString()
                };
                
                classReps.unshift(rep);
                localStorage.setItem('sehomeClassReps', JSON.stringify(classReps));
                
                document.getElementById('repName').value = '';
                document.getElementById('repRole').value = 'Class Representative';
                document.getElementById('repPhoto').value = '';
                
                renderSpotlightList();
                renderPublicSpotlights();
                updateAnalytics();
                
                logAdminActivity(`Added ${rep.name} as ${rep.role}`);
                resetSession();
                showNotification('👑 Class representative added!');
            });
        }

        function renderSpotlightList() {
            const spotlightList = document.getElementById('spotlightList');
            spotlightList.innerHTML = '';
            
            if (classReps.length === 0) {
                spotlightList.innerHTML = '<p style="color: #666; text-align: center; padding: 2rem;">No class representatives added yet.</p>';
                return;
            }
            
            classReps.forEach((rep, index) => {
                const repCard = document.createElement('div');
                repCard.className = 'spotlight-card rotate-in';
                repCard.setAttribute('data-spotlight-id', rep.id);
                repCard.style.animationDelay = `${index * 0.2}s`;
                
                repCard.innerHTML = `
                    <div class="card-header">
                        <div class="card-title">👑 ${rep.name}</div>
                        <div class="card-actions">
                            <button class="action-btn delete" onclick="deleteSpotlight(${rep.id})">🗑️ Remove</button>
                        </div>
                    </div>
                    <p><strong>Role:</strong> ${rep.role}</p>
                    <p><strong>Photo:</strong> <img src="${rep.photo}" alt="${rep.name}" style="width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 2px solid #ffd700;" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                    <span style="display: none; color: #999;">Photo failed to load</span></p>
                    <small>Added: ${rep.date}</small>
                `;
                
                spotlightList.appendChild(repCard);
            });
        }

        function renderPublicSpotlights() {
            const publicList = document.getElementById('publicSpotlightList');
            
            if (classReps.length > 0) {
                publicList.innerHTML = '';
                classReps.forEach(rep => {
                    const repCard = document.createElement('div');
                    repCard.className = 'rep-card';
                    
                    repCard.innerHTML = `
                        <img src="${rep.photo}" alt="${rep.name}" class="rep-photo" onerror="this.src=''; this.alt='Photo failed to load'; this.style.display='none';">
                        <div class="rep-name">${rep.name}</div>
                        <div class="rep-role">👑 ${rep.role}</div>
                    `;
                    
                    publicList.appendChild(repCard);
                });
            }
        }

