                            <label style="color: #1a5f1a; font-weight: bold; margin-bottom: 0.5rem; display: block;">Event to Remind About:</label>
                            <select id="reminderEvent" style="width: 100%; padding: 1rem; border: 2px solid #ffd700; border-radius: 10px; font-size: 1rem;" required>
                                <option value="">Select an upcoming event</option>
                                ${getUpcomingEventsOptions()}
                            </select>
                        </div>
                        
                        <div class="form-group" style="margin-bottom: 1.5rem;">
                            <label style="color: #1a5f1a; font-weight: bold; margin-bottom: 0.5rem; display: block;">Reminder Time:</label>
                            <select id="reminderTime" style="width: 100%; padding: 1rem; border: 2px solid #ffd700; border-radius: 10px; font-size: 1rem;" required>
                                <option value="1">1 day before</option>
                                <option value="3">3 days before</option>
                                <option value="7">1 week before</option>
                                <option value="14">2 weeks before</option>
                            </select>
                        </div>
                        
                        <div class="form-group" style="margin-bottom: 2rem;">
                            <label style="color: #1a5f1a; font-weight: bold; margin-bottom: 0.5rem; display: block;">Custom Message (Optional):</label>
                            <textarea id="reminderMessage" rows="3" placeholder="Add a custom reminder message..." style="width: 100%; padding: 1rem; border: 2px solid #ffd700; border-radius: 10px; font-size: 1rem; resize: vertical;"></textarea>
                        </div>
                        
                        <div style="text-align: center; display: flex; gap: 1rem; justify-content: center;">
                            <button type="submit" class="action-btn" style="background: linear-gradient(45deg, #1a5f1a, #2d4a2d);">⏰ Set Reminder</button>
                            <button type="button" class="action-btn" onclick="this.closest('.bulk-modal').remove()">Cancel</button>
                        </div>
                    </form>
                    
                    <div id="activeReminders" style="margin-top: 2rem; max-height: 300px; overflow-y: auto;">
                        ${renderActiveReminders()}
                    </div>
                </div>
            `;
            
            document.body.appendChild(modal);
        }

        function getUpcomingEventsOptions() {
            const today = new Date();
            const upcomingEvents = [];
            
            Object.keys(events).forEach(dateKey => {
                const eventDate = new Date(dateKey);
                if (eventDate > today) {
                    events[dateKey].forEach(event => {
                        upcomingEvents.push({
                            ...event,
                            date: dateKey
                        });
                    });
                }
            });
            
            upcomingEvents.sort((a, b) => new Date(a.date) - new Date(b.date));
            
            return upcomingEvents.map(event => {
                const eventDate = new Date(event.date).toLocaleDateString();
                return `<option value="${event.id}|${event.date}">${event.title} - ${eventDate}</option>`;
            }).join('');
        }

        function createEventReminder(e, modal) {
            e.preventDefault();
            
            const eventInfo = document.getElementById('reminderEvent').value.split('|');
            const eventId = eventInfo[0];
            const eventDate = eventInfo[1];
            const daysBefore = parseInt(document.getElementById('reminderTime').value);
            const customMessage = document.getElementById('reminderMessage').value;
            
            // Find the event
            const event = events[eventDate].find(e => e.id == eventId);
            if (!event) return;
            
            const reminderDate = new Date(eventDate);
            reminderDate.setDate(reminderDate.getDate() - daysBefore);
            
            const reminder = {
                id: Date.now(),
                eventId: eventId,
                eventDate: eventDate,
                eventTitle: event.title,
                reminderDate: reminderDate.toISOString(),
                daysBefore: daysBefore,
                customMessage: customMessage,
                active: true,
                createdBy: 'admin',
                createdAt: new Date().toISOString()
            };
            
            let reminders = JSON.parse(localStorage.getItem('eventReminders')) || [];
            reminders.push(reminder);
            localStorage.setItem('eventReminders', JSON.stringify(reminders));
            
            modal.remove();
            logAdminActivity(`Set reminder for ${event.title} - ${daysBefore} days before`);
            showNotification(`⏰ Reminder set for ${event.title} (${daysBefore} days before)`);
        }

        function renderActiveReminders() {
            const reminders = JSON.parse(localStorage.getItem('eventReminders')) || [];
            const activeReminders = reminders.filter(r => r.active && new Date(r.eventDate) > new Date());
            
            if (activeReminders.length === 0) {
                return '<p style="color: #666; text-align: center; padding: 1rem;">No active reminders set.</p>';
            }
            
            let remindersList = '<h4 style="color: #1a5f1a; margin-bottom: 1rem;">⏰ Active Reminders</h4>';
            
            activeReminders.forEach(reminder => {
                const reminderDate = new Date(reminder.reminderDate).toLocaleDateString();
                const eventDate = new Date(reminder.eventDate).toLocaleDateString();
                
                remindersList += `
                    <div style="background: rgba(255, 255, 255, 0.9); border: 2px solid #ffd700; border-radius: 10px; padding: 1rem; margin-bottom: 0.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <strong style="color: #1a5f1a;">${reminder.eventTitle}</strong>
                                <div style="color: #666; font-size: 0.9rem;">Event: ${eventDate}</div>
                                <div style="color: #666; font-size: 0.9rem;">Remind: ${reminderDate}</div>
                            </div>
                            <div style="text-align: right;">
                                <div style="color: #ffd700; font-weight: bold;">${reminder.daysBefore} days</div>
                                <button onclick="cancelReminder(${reminder.id})" style="background: #cc0000; color: white; border: none; padding: 0.3rem 0.6rem; border-radius: 5px; font-size: 0.8rem; cursor: pointer;">Cancel</button>
                            </div>
                        </div>
                    </div>
                `;
            });
            
            return remindersList;
        }

        function cancelReminder(reminderId) {
            let reminders = JSON.parse(localStorage.getItem('eventReminders')) || [];
            const reminderIndex = reminders.findIndex(r => r.id === reminderId);
            
            if (reminderIndex !== -1) {
                reminders[reminderIndex].active = false;
                localStorage.setItem('eventReminders', JSON.stringify(reminders));
                
                // Refresh the modal if it's open
                const modal = document.querySelector('.bulk-modal');
                if (modal) {
                    const activeRemindersDiv = document.getElementById('activeReminders');
                    if (activeRemindersDiv) {
                        activeRemindersDiv.innerHTML = renderActiveReminders();
                    }
                }
                
                showNotification('⏰ Reminder cancelled');
            }
        }

