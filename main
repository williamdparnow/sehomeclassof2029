            document.getElementById('overrideReason').value = '';
        }

        function setSchoolDayOverride(e) {
            e.preventDefault();
            
            const date = document.getElementById('overrideDate').value;
            const type = document.getElementById('overrideType').value;
            const reason = document.getElementById('overrideReason').value;
            
            schoolDayOverrides[date] = {
                type: type,
                reason: reason,
                setBy: 'admin',
                setDate: new Date().toISOString()
            };
            
            localStorage.setItem('schoolDayOverrides', JSON.stringify(schoolDayOverrides));
            
            renderCalendar();
            updateTodayInfo();
            closeSchoolDayModal();
            
            const typeNames = {
                'no-school': 'No School',
                'early-release': 'Early Release',
                'late-start': 'Late Start',
                'half-day': 'Half Day',
                'assembly': 'Assembly Schedule',
                'testing': 'Testing Schedule'
            };
            
            logAdminActivity(`Set school day override: ${typeNames[type]} on ${date}`);
            resetSession();
            showNotification(`🏫 School day override set: ${typeNames[type]} on ${new Date(date).toLocaleDateString()}`);
        }

