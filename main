        function updateSiteTheme(e, modal) {
            e.preventDefault();
            
            siteTheme.primary = document.getElementById('primaryColor').value;
            siteTheme.secondary = document.getElementById('secondaryColor').value;
            siteTheme.accent = document.getElementById('accentColor').value;
            
            localStorage.setItem('siteTheme', JSON.stringify(siteTheme));
            
            modal.remove();
            logAdminActivity('Updated site theme colors');
            showNotification('🎨 Theme colors saved! (Demo feature - colors not applied to live site)');
        }

        function resetToDefaultTheme(modal) {
            siteTheme = { primary: '#1a5f1a', secondary: '#ffd700', accent: '#2d4a2d' };
            localStorage.setItem('siteTheme', JSON.stringify(siteTheme));
            
            modal.remove();
            logAdminActivity('Reset site theme to default');
            showNotification('🔄 Theme reset to default colors!');
        }

        // Initialize the application
        function initializeApp() {
            // Hide loading screen after 10 seconds
            setTimeout(() => {
                const loadingScreen = document.getElementById('loadingScreen');
                loadingScreen.style.opacity = '0';
                loadingScreen.style.transform = 'scale(0.8)';
                
                setTimeout(() => {
                    loadingScreen.style.display = 'none';
                }, 800);
            }, 10000);
            
            renderCalendar();
            renderEventsList();
            updateTodayInfo();
            renderPublicAnnouncements();
            renderPublicSpotlights();
            renderActivePolls();
            updateAnalytics();
            checkCelebrationState();
            
            // Set up keyboard shortcuts and secret access
            document.addEventListener('keydown', function(e) {
                // Handle secret word typing (only when not in input fields)
                if (!e.target.matches('input, textarea, select')) {
                    // Only capture letter keys
                    if (e.key.length === 1 && e.key.match(/[a-zA-Z]/)) {
                        handleSecretInput(e.key);
                    }
                }
                
                if (e.key === 'Escape') {
                    closeSecurityModal();
                    closeBulkModal();
                    closeCelebrationModal();
                    closeSchoolDayModal();
                    closeMoodBoosterModal();
                    closeStudentPollModal();
                    closeEventDetail();
                    cancelEventDeletion();
                    closeCropModal();

                }
                
                if (e.key === 'Enter' && e.target.id === 'passcodeInput') {
                    checkPasscode();
                }
                
                if (e.key === 'Enter' && e.target.id === 'securityAnswer') {
                    checkSecurityAnswer();
                }
            });
            
            // Auto-focus passcode input when modal opens
            const passcodeModal = document.getElementById('passcodeModal');
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
                        if (passcodeModal.style.display === 'flex') {
                            setTimeout(() => {
                                const input = document.getElementById('passcodeInput');
                                if (input) input.focus();
                            }, 100);
                        }
                    }
                });
            });
            observer.observe(passcodeModal, { attributes: true });
        }

        // Start the app when page loads
        document.addEventListener('DOMContentLoaded', initializeApp)
