                            <button type="button" class="action-btn" onclick="this.closest('.bulk-modal').remove()">Cancel</button>
                        </div>
                    </form>
                    
                    <div id="photoGallery" style="margin-top: 2rem; max-height: 300px; overflow-y: auto;">
                        ${renderPhotoGallery()}
                    </div>
                </div>
            `;
            
            document.body.appendChild(modal);
        }

        function addClassPhoto(e, modal) {
            e.preventDefault();
            
            const photoFile = document.getElementById('classPhotoFile').files[0];
            const caption = document.getElementById('photoCaption').value;
            
            if (!photoFile) return;
            
            const reader = new FileReader();
            reader.onload = function(event) {
                const photo = {
                    id: Date.now(),
                    caption: caption,
                    imageData: event.target.result,
                    date: new Date().toISOString(),
                    uploadedBy: 'admin'
                };
                
                classPhotos.unshift(photo);
                localStorage.setItem('classPhotos', JSON.stringify(classPhotos));
                
                modal.remove();
                logAdminActivity(`Added class photo: ${caption}`);
                showNotification('📸 Photo added to class gallery!');
            };
            reader.readAsDataURL(photoFile);
        }

        function renderPhotoGallery() {
            if (classPhotos.length === 0) {
                return '<p style="color: #666; text-align: center; padding: 1rem;">No photos uploaded yet.</p>';
            }
            
            let gallery = '<h4 style="color: #1a5f1a; margin-bottom: 1rem;">📷 Recent Photos</h4>';
            
            classPhotos.slice(0, 3).forEach(photo => {
                gallery += `
                    <div style="background: rgba(255, 255, 255, 0.9); border: 2px solid #ffd700; border-radius: 10px; padding: 1rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 1rem;">
                        <img src="${photo.imageData}" alt="${photo.caption}" style="width: 60px; height: 60px; border-radius: 8px; object-fit: cover;">
                        <div>
                            <strong style="color: #1a5f1a;">${photo.caption}</strong>
                            <div style="color: #666; font-size: 0.9rem;">${new Date(photo.date).toLocaleDateString()}</div>
                        </div>
                    </div>
                `;
            });
            
            return gallery;
        }

        function showQuickStats() {
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            const totalEvents = Object.keys(events).reduce((total, date) => total + events[date].length, 0);
            const sportsEvents = Object.keys(events).reduce((total, date) => {
                return total + events[date].filter(event => event.category === 'sports').length;
            }, 0);
            const completedGames = Object.keys(events).reduce((total, date) => {
                return total + events[date].filter(event => event.category === 'sports' && event.score).length;
            }, 0);
            const wins = Object.keys(events).reduce((total, date) => {
                return total + events[date].filter(event => event.result === 'W').length;
            }, 0);
            
            const modal = document.createElement('div');
            modal.className = 'bulk-modal';
            modal.style.display = 'flex';
            modal.innerHTML = `
                <div class="bulk-modal-content">
                    <h3 style="color: #1a5f1a; text-align: center; margin-bottom: 2rem;">📊 Class of 2029 Quick Stats</h3>
                    
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
                        <div style="background: linear-gradient(135deg, #e8f5e8, #f0f8f0); padding: 1.5rem; border-radius: 15px; text-align: center; border: 2px solid #1a5f1a;">
                            <div style="font-size: 2.5rem; color: #1a5f1a; margin-bottom: 0.5rem;">${totalEvents}</div>
                            <div style="color: #1a5f1a; font-weight: bold;">Total Events</div>
                        </div>
                        
                        <div style="background: linear-gradient(135deg, #fff8e8, #fffaf0); padding: 1.5rem; border-radius: 15px; text-align: center; border: 2px solid #ffd700;">
                            <div style="font-size: 2.5rem; color: #ffd700; margin-bottom: 0.5rem;">${announcements.length}</div>
                            <div style="color: #1a5f1a; font-weight: bold;">Announcements</div>
                        </div>
                        
                        <div style="background: linear-gradient(135d, #f0f0f8, #f5f5f8); padding: 1.5rem; border-radius: 15px; text-align: center; border: 2px solid #2d4a2d;">
                            <div style="font-size: 2.5rem; color: #2d4a2d; margin-bottom: 0.5rem;">${suggestions.length}</div>
                            <div style="color: #1a5f1a; font-weight: bold;">Student Ideas</div>
                        </div>
                        
                        <div style="background: linear-gradient(135deg, #e8ffe8, #f0fff0); padding: 1.5rem; border-radius: 15px; text-align: center; border: 2px solid #1a5f1a;">
                            <div style="font-size: 2.5rem; color: #1a5f1a; margin-bottom: 0.5rem;">${wins}/${completedGames}</div>
                            <div style="color: #1a5f1a; font-weight: bold;">Sports Record</div>
                        </div>
                    </div>
                    
                    <div style="text-align: center;">
                        <button class="action-btn" onclick="this.closest('.bulk-modal').remove()">Close</button>
                    </div>
                </div>
            `;
            
            document.body.appendChild(modal);
        }

