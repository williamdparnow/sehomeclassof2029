    <script>
        // Global Variables
        let currentDate = new Date();
        let selectedDate = null;
        let events = JSON.parse(localStorage.getItem('sehomeEvents')) || {};
        let suggestions = JSON.parse(localStorage.getItem('sehomeSuggestions')) || [];
        let announcements = JSON.parse(localStorage.getItem('sehomeAnnouncements')) || [];
        let classReps = JSON.parse(localStorage.getItem('sehomeClassReps')) || [];
        let schoolDayOverrides = JSON.parse(localStorage.getItem('schoolDayOverrides')) || {};
        let activePools = JSON.parse(localStorage.getItem('activePolls')) || [];
        let moodBoosters = JSON.parse(localStorage.getItem('moodBoosters')) || [];
        let classPhotos = JSON.parse(localStorage.getItem('classPhotos')) || [];
        let siteTheme = JSON.parse(localStorage.getItem('siteTheme')) || { primary: '#1a5f1a', secondary: '#ffd700', accent: '#2d4a2d' };

        let siteSettings = JSON.parse(localStorage.getItem('siteSettings')) || {
            instagramHandle: '@sehome2029',
            instagramUrl: 'https://instagram.com/sehome2029',
            sessionTimeout: 15
        };
        
        // Enhanced Security System
        const ADMIN_PASSCODE = '2029';
        const SECURITY_STEPS = [
            { type: "phrase", prompt: "What's our school mascot's favorite attack?", answer: "shark attack", placeholder: "Two words..." }
        ];
        
        let isAdminAuthenticated = false;
        let loginAttempts = 0;
        let lockoutTime = 0;
        let sessionTimeout = null;
        let currentSecurityStep = null;
        let currentStepIndex = 0;
        
        // A/B Day system - starts with A day on first school day
        const SCHOOL_START_DATE = new Date('2024-09-03');

        const months = [
            'January', 'February', 'March', 'April', 'May', 'June',
            'July', 'August', 'September', 'October', 'November', 'December'
        ];

        const daysOfWeek = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

        // Notification System
        function showNotification(message, type = 'success') {
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            
            notification.onclick = () => {
                notification.style.animation = 'successSlideOut 0.4s ease-in';
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 400);
            };
            
            notification.onmouseenter = () => {
                notification.style.animation = 'successPulse 0.6s ease-in-out infinite';
            };
            notification.onmouseleave = () => {
                notification.style.animation = 'none';
            };
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.style.animation = 'successSlideOut 0.4s ease-in';
                    setTimeout(() => {
                        if (notification.parentNode) {
                            notification.parentNode.removeChild(notification);
                        }
                    }, 400);
                }
            }, 4000);
        }

        // Celebration Functions
        function showCelebrationModal() {
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            document.getElementById('celebrationModal').style.display = 'flex';
            document.getElementById('celebrationReason').focus();
        }

        function closeCelebrationModal() {
            document.getElementById('celebrationModal').style.display = 'none';
            document.getElementById('celebrationReason').value = '';
        }

        function startCelebration(e) {
            e.preventDefault();
            
            const reason = document.getElementById('celebrationReason').value;
            
            // Save celebration state for 24 hours
            const celebrationData = {
                message: reason,
                startTime: Date.now(),
                duration: 24 * 60 * 60 * 1000 // 24 hours in milliseconds
            };
            
            localStorage.setItem('celebrationData', JSON.stringify(celebrationData));
            
            // Show celebration for this admin immediately
            showCelebrationToUser(reason);
            
            closeCelebrationModal();
            logAdminActivity(`Started celebration: ${reason}`);
            showNotification('🎉 Celebration mode activated for 24 hours! New visitors will see it for 25 seconds.');
        }

        function createConfetti() {
            const colors = ['#ffd700', '#ffed4e', '#1a5f1a', '#2d4a2d'];
            
            for (let i = 0; i < 50; i++) {
                setTimeout(() => {
                    const confetti = document.createElement('div');
                    confetti.className = 'confetti-particle';
                    confetti.style.position = 'fixed';
                    confetti.style.left = Math.random() * 100 + 'vw';
                    confetti.style.top = '-100px';
                    confetti.style.width = '10px';
                    confetti.style.height = '10px';
                    confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                    confetti.style.animation = `confetti ${Math.random() * 2 + 3}s linear forwards`;
                    confetti.style.zIndex = '10000';
                    confetti.style.pointerEvents = 'none';
                    
                    document.body.appendChild(confetti);
                    
                    setTimeout(() => {
                        if (confetti.parentNode) {
                            confetti.parentNode.removeChild(confetti);
                        }
                    }, 5000);
                }, i * 100);
            }
        }

        function showCelebrationToUser(message) {
            const banner = document.getElementById('celebrationBanner');
            const messageElement = document.getElementById('celebrationMessage');
            messageElement.textContent = `🎉 ${message} 🎉`;
            
            banner.classList.add('active');
            document.body.classList.add('celebrating');
            
            // Create confetti
            createConfetti();
            
            // Hide after 25 seconds for this user only
            setTimeout(() => {
                hideCelebrationForUser();
            }, 25000);
        }

        function hideCelebrationForUser() {
            const banner = document.getElementById('celebrationBanner');
            banner.classList.remove('active');
            document.body.classList.remove('celebrating');
            
            // Mark that this user has seen the celebration
            const celebrationData = JSON.parse(localStorage.getItem('celebrationData'));
            if (celebrationData) {
                localStorage.setItem('celebrationSeen', 'true');
            }
        }

        function closeCelebration() {
            // This is for manual close by admin - removes celebration completely
            const banner = document.getElementById('celebrationBanner');
            banner.classList.remove('active');
            document.body.classList.remove('celebrating');
            
            // Clear celebration state completely
            localStorage.removeItem('celebrationData');
            localStorage.removeItem('celebrationSeen');
            
            logAdminActivity('Ended celebration mode');
            showNotification('🎉 Celebration ended completely!');
        }

        function checkCelebrationState() {
            const celebrationData = JSON.parse(localStorage.getItem('celebrationData'));
            const hasSeenCelebration = localStorage.getItem('celebrationSeen');
            
            if (celebrationData) {
                const now = Date.now();
                const timeElapsed = now - celebrationData.startTime;
                
                // Check if celebration has expired (24 hours)
                if (timeElapsed > celebrationData.duration) {
                    localStorage.removeItem('celebrationData');
                    localStorage.removeItem('celebrationSeen');
                    return;
                }
                
                // If user hasn't seen the celebration yet, show it
                if (!hasSeenCelebration) {
                    showCelebrationToUser(celebrationData.message);
                }
            }
        }



        // Security functions
        function isLockedOut() {
            return Date.now() < lockoutTime;
        }
        
        function lockAccount() {
            lockoutTime = Date.now() + (5 * 60 * 1000); // 5 minute lockout
            loginAttempts = 0;
        }
        
        function resetSession() {
            if (sessionTimeout) clearTimeout(sessionTimeout);
            sessionTimeout = setTimeout(() => {
                isAdminAuthenticated = false;
                document.getElementById('adminPanel').style.display = 'none';
                document.querySelector('.admin-btn').textContent = '🔐 Representative Access';
                showNotification('🔒 Session expired for security. Please log in again.', 'warning');
            }, 15 * 60 * 1000); // 15 minute session
        }
        
        function getNextSecurityStep() {
            if (currentStepIndex < SECURITY_STEPS.length) {
                return SECURITY_STEPS[currentStepIndex];
            }
            return null;
        }

        // School day calculation functions
        function isWeekend(date) {
            const day = date.getDay();
            return day === 0 || day === 6; // Sunday or Saturday
        }

        function getSchoolDayType(date) {
            const dateKey = date.toISOString().split('T')[0];
            
            // Check for school day overrides first
            if (schoolDayOverrides[dateKey]) {
                const override = schoolDayOverrides[dateKey];
                const overrideTypes = {
                    'no-school': { type: 'no-school', display: 'No School', color: '#cc0000' },
                    'early-release': { type: 'early-release', display: 'Early Release', color: '#ff8800' },
                    'late-start': { type: 'late-start', display: 'Late Start', color: '#0088cc' },
                    'half-day': { type: 'half-day', display: 'Half Day', color: '#9966cc' },
                    'assembly': { type: 'assembly', display: 'Assembly Schedule', color: '#cc6600' },
                    'testing': { type: 'testing', display: 'Testing Schedule', color: '#666666' }
                };
                
                return overrideTypes[override.type] || { type: 'override', display: override.type, color: '#666' };
            }
            
            // Check if it's a weekend
            if (isWeekend(date)) {
                return { type: 'weekend', display: 'Weekend', color: '#999' };
            }
            
            // Calculate A/B day
            const schoolDays = getSchoolDaysSince(SCHOOL_START_DATE, date);
            const isADay = schoolDays % 2 === 0;
            
            return {
                type: isADay ? 'a-day' : 'b-day',
                display: isADay ? 'A Day' : 'B Day',
                color: isADay ? '#1a5f1a' : '#2d4a2d'
            };
        }

        function getSchoolDaysSince(startDate, currentDate) {
            let count = 0;
            let date = new Date(startDate);
            
            while (date < currentDate) {
                // Only count weekdays
                if (!isWeekend(date)) {
                    count++;
                }
                date.setDate(date.getDate() + 1);
            }
            
            return count;
        }

        function updateTodayInfo() {
            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);
            
            const todayType = getSchoolDayType(today);
            const tomorrowType = getSchoolDayType(tomorrow);
            
            document.getElementById('todayType').textContent = todayType.display;
            document.getElementById('todayType').style.color = todayType.color;
            
            document.getElementById('nextDayType').textContent = tomorrowType.display;
            document.getElementById('nextDayType').style.color = tomorrowType.color;
        }

        function renderCalendar() {
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();
            
            // Update month display
            const monthElement = document.getElementById('currentMonth');
            monthElement.textContent = `${months[month]} ${year}`;
            
            const firstDay = new Date(year, month, 1);
            const startDate = new Date(firstDay);
            startDate.setDate(startDate.getDate() - firstDay.getDay());
            
            const calendarGrid = document.getElementById('calendarGrid');
            calendarGrid.innerHTML = '';
            
            // Add day headers
            daysOfWeek.forEach(day => {
                const dayHeader = document.createElement('div');
                dayHeader.className = 'calendar-day-header';
                dayHeader.textContent = day;
                calendarGrid.appendChild(dayHeader);
            });
            
            // Add calendar days (6 weeks = 42 days)
            for (let i = 0; i < 42; i++) {
                const date = new Date(startDate);
                date.setDate(startDate.getDate() + i);
                
                const dayElement = document.createElement('div');
                dayElement.className = 'calendar-day';
                
                // Check if this day is in the current month
                if (date.getMonth() !== month) {
                    dayElement.classList.add('other-month');
                } else {
                    // Add day type styling for current month
                    const dayType = getSchoolDayType(date);
                    dayElement.classList.add(dayType.type);
                    
                    // Add day type indicator
                    const indicator = document.createElement('div');
                    indicator.className = 'day-type-indicator';
                    indicator.textContent = dayType.display;
                    indicator.style.color = dayType.color;
                    dayElement.appendChild(indicator);
                }
                
                // Add day number
                const dayNumber = document.createElement('div');
                dayNumber.className = 'day-number';
                dayNumber.textContent = date.getDate();
                dayElement.appendChild(dayNumber);
                
                // Add events for this date
                const dateKey = date.toISOString().split('T')[0];
                if (events[dateKey]) {
                    events[dateKey].forEach(event => {
                        const eventElement = document.createElement('div');
                        eventElement.className = 'event';
                        
                        // Add admin hover delete functionality if admin is authenticated
                        if (isAdminAuthenticated) {
                            eventElement.classList.add('admin-mode');
                            setupAdminEventHover(eventElement, event, dateKey);
                        }
                        
                        // Add spirit week class for special styling
                        if (event.category === 'spirit-week') {
                            eventElement.classList.add('spirit-week');
                        }
                        
                        // Store event data for deletion
                        eventElement.setAttribute('data-event-id', event.id);
                        eventElement.setAttribute('data-event-date', dateKey);
                        eventElement.setAttribute('data-event-title', event.title);
                        
                        // Get category info
                        const categoryEmojis = {
                            academic: '📚',
                            social: '🎉',
                            sports: '🏆',
                            club: '🎭',
                            school: '🏫',
                            other: '📝'
                        };
                        
                        const categoryEmoji = categoryEmojis[event.category] || '📝';
                        const sportConfig = event.sportsType ? SPORTS_CONFIG[event.sportsType] : null;
                        
                        let displayTitle = event.title;
                        if (sportConfig) {
                            const genderEmoji = event.gender === 'boys' ? '👦' : event.gender === 'girls' ? '👧' : '';
                            displayTitle = `${sportConfig.emoji}${genderEmoji} ${event.title}`;
                        } else if (event.category === 'spirit-week' && event.spiritTheme && SPIRIT_THEMES[event.spiritTheme]) {
                            const themeConfig = SPIRIT_THEMES[event.spiritTheme];
                            displayTitle = `${themeConfig.emoji} ${themeConfig.name}`;
                        } else {
                            displayTitle = `${categoryEmoji} ${event.title}`;
                        }
                        
                        // Add score indicator for completed sports events
                        if (event.score && event.result) {
                            const resultEmoji = event.result === 'W' ? '🎉' : event.result === 'L' ? '😔' : '🤝';
                            displayTitle += ` ${resultEmoji}`;
                        }
                        
                        eventElement.textContent = displayTitle;
                        
                        // Enhanced tooltip
                        let tooltip = event.description || event.title;
                        if (event.gender) tooltip += `\n${event.gender === 'boys' ? '👦 Boys' : '👧 Girls'} Team`;
                        if (event.opponent) tooltip += `\nvs ${event.opponent}`;
                        if (event.location) tooltip += `\n📍 ${event.location}`;
                        if (event.time) tooltip += `\n🕐 ${event.time}`;
                        if (event.spiritTheme && SPIRIT_THEMES[event.spiritTheme]) {
                            tooltip += `\n🌟 ${SPIRIT_THEMES[event.spiritTheme].name}`;
                        }
                        if (event.score) {
                            tooltip += `\n🏆 Final: Sehome ${event.score.sehome} - ${event.opponent || 'Opponent'} ${event.score.opponent}`;
                        }
                        
                        if (isAdminAuthenticated) {
                            tooltip += '\n\n🖱️ Click for details • Hover for delete option';
                        } else {
                            tooltip += '\n\n🖱️ Click for full details!';
                        }
                        
                        eventElement.title = tooltip;
                        
                        // Add click handler
                        eventElement.addEventListener('click', (e) => {
                            e.stopPropagation();
                            showEventDetail(event, dateKey);
                        });
                        
                        dayElement.appendChild(eventElement);
                    });
                }
                
                // Highlight today
                const today = new Date();
                if (date.toDateString() === today.toDateString()) {
                    dayElement.classList.add('selected');
                }
                
                dayElement.addEventListener('click', () => selectDate(date, dayElement));
                calendarGrid.appendChild(dayElement);
            }
        }

        function selectDate(date, element) {
            document.querySelectorAll('.calendar-day.selected').forEach(day => {
                day.classList.remove('selected');
            });
            
            element.classList.add('selected');
            selectedDate = date;
            
            // Show day details with animation
            showDayDetails(date, element);
        }

        function showDayDetails(date, element) {
            const dateKey = date.toISOString().split('T')[0];
            const dayEvents = events[dateKey] || [];
            
            // Remove any existing day details
            const existingDetails = document.querySelector('.day-details-popup');
            if (existingDetails) {
                existingDetails.remove();
            }
            
            // Create day details popup
            const popup = document.createElement('div');
            popup.className = 'day-details-popup';
            popup.style.cssText = `
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%) scale(0.8);
                background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.95));
                border: 3px solid #ffd700;
                border-radius: 20px;
                padding: 2rem;
                max-width: 500px;
                width: 90%;
                max-height: 80vh;
                overflow-y: auto;
                z-index: 10000;
                box-shadow: 0 25px 80px rgba(255, 215, 0, 0.8);
                opacity: 0;
                transition: all 0.3s ease-out;
            `;
            
            const formattedDate = date.toLocaleDateString('en-US', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
            
            const dayType = getSchoolDayType(date);
            
            let eventsHtml = '';
            if (dayEvents.length === 0) {
                eventsHtml = `
                    <div style="text-align: center; padding: 2rem; color: #666; font-style: italic;">
                        <div style="font-size: 3rem; margin-bottom: 1rem;">📅</div>
                        <h3 style="color: #1a5f1a; margin-bottom: 0.5rem;">No events on ${formattedDate.split(',')[0]}!</h3>
                        <p>Enjoy your free time or check back later for updates.</p>
                    </div>
                `;
            } else {
                eventsHtml = '<div style="margin-top: 1.5rem;">';
                dayEvents.forEach(event => {
                    const categoryEmojis = {
                        academic: '📚',
                        social: '🎉',
                        sports: '🏆',
                        club: '🎭',
                        school: '🏫',
                        'spirit-week': '🌟',
                        other: '📝'
                    };
                    
                    const categoryEmoji = categoryEmojis[event.category] || '📝';
                    const sportConfig = event.sportsType ? SPORTS_CONFIG[event.sportsType] : null;
                    
                    let eventTitle = event.title;
                    if (sportConfig) {
                        const genderText = event.gender ? ` (${event.gender === 'boys' ? 'Boys' : 'Girls'})` : '';
                        eventTitle = `${sportConfig.emoji} ${sportConfig.name}${genderText} - ${event.title}`;
                    } else if (event.category === 'spirit-week' && event.spiritTheme && SPIRIT_THEMES[event.spiritTheme]) {
                        const themeConfig = SPIRIT_THEMES[event.spiritTheme];
                        eventTitle = `${themeConfig.emoji} ${themeConfig.name}`;
                    } else {
                        eventTitle = `${categoryEmoji} ${event.title}`;
                    }
                    
                    let scoreDisplay = '';
                    if (event.score) {
                        const resultEmoji = event.result === 'W' ? '🎉' : event.result === 'L' ? '😔' : '🤝';
                        scoreDisplay = `
                            <div style="background: ${event.result === 'W' ? '#e8f5e8' : event.result === 'L' ? '#ffe8e8' : '#f0f0f0'}; padding: 0.8rem; border-radius: 8px; margin-top: 0.5rem; border: 2px solid ${event.result === 'W' ? '#1a5f1a' : event.result === 'L' ? '#cc0000' : '#999'}; font-size: 0.9rem;">
                                <strong>${resultEmoji} Final:</strong> Sehome ${event.score.sehome} - ${event.opponent || 'Opponent'} ${event.score.opponent}
                            </div>
                        `;
                    }
                    
                    eventsHtml += `
                        <div style="background: rgba(255, 215, 0, 0.1); border: 2px solid #ffd700; border-radius: 15px; padding: 1.5rem; margin-bottom: 1rem; cursor: pointer; transition: all 0.3s ease;" onclick="showEventDetail(${JSON.stringify(event).replace(/"/g, '&quot;')}, '${dateKey}'); document.querySelector('.day-details-popup').remove();">
                            <h4 style="color: #1a5f1a; margin-bottom: 0.5rem; font-size: 1.2rem;">${eventTitle}</h4>
                            ${event.time ? `<p style="color: #666; margin: 0.5rem 0;"><strong>🕐 Time:</strong> ${event.time}</p>` : ''}
                            ${event.opponent ? `<p style="color: #666; margin: 0.5rem 0;"><strong>🆚 Opponent:</strong> ${event.opponent}</p>` : ''}
                            ${event.location ? `<p style="color: #666; margin: 0.5rem 0;"><strong>📍 Location:</strong> ${event.location}</p>` : ''}
                            ${event.description ? `<p style="color: #666; margin: 0.5rem 0;">${event.description}</p>` : ''}
                            ${scoreDisplay}
                            <p style="color: #999; font-size: 0.9rem; margin: 0.5rem 0 0 0; font-style: italic;">Click for full details →</p>
                        </div>
                    `;
                });
                eventsHtml += '</div>';
            }
            
            popup.innerHTML = `
                <div style="text-align: center; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 3px solid #ffd700;">
                    <h2 style="color: #1a5f1a; margin-bottom: 0.5rem; font-size: 1.8rem;">${formattedDate}</h2>
                    <div style="background: linear-gradient(45deg, ${dayType.color}, ${dayType.color}aa); color: white; padding: 0.5rem 1rem; border-radius: 20px; display: inline-block; font-weight: bold; text-shadow: 1px 1px 2px rgba(0,0,0,0.3);">
                        ${dayType.display}
                    </div>
                </div>
                ${eventsHtml}
                <div style="text-align: center; margin-top: 2rem;">
                    <button onclick="document.querySelector('.day-details-popup').remove()" style="background: linear-gradient(45deg, #1a5f1a, #2d4a2d); color: #ffd700; border: none; padding: 1rem 2rem; border-radius: 15px; cursor: pointer; font-weight: bold; font-size: 1rem; transition: all 0.3s ease;">Close</button>
                </div>
            `;
            
            document.body.appendChild(popup);
            
            // Animate in
            setTimeout(() => {
                popup.style.transform = 'translate(-50%, -50%) scale(1)';
                popup.style.opacity = '1';
            }, 10);
            
            // Close on escape key
            const handleEscape = (e) => {
                if (e.key === 'Escape') {
                    popup.remove();
                    document.removeEventListener('keydown', handleEscape);
                }
            };
            document.addEventListener('keydown', handleEscape);
            
            // Close on background click
            popup.addEventListener('click', (e) => {
                if (e.target === popup) {
                    popup.remove();
                }
            });
        }

        function previousMonth() {
            currentDate.setMonth(currentDate.getMonth() - 1);
            renderCalendar();
        }

        function nextMonth() {
            currentDate.setMonth(currentDate.getMonth() + 1);
            renderCalendar();
        }

        function renderEventsList() {
            const eventsList = document.getElementById('publicEventsList');
            
            // Get all events and sort by date
            const allEvents = [];
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            
            // Add events from localStorage
            Object.keys(events).forEach(dateKey => {
                const eventDate = new Date(dateKey);
                if (eventDate >= today) {
                    events[dateKey].forEach(event => {
                        allEvents.push({
                            ...event,
                            date: dateKey
                        });
                    });
                }
            });
            
            // Add sample events for demonstration
            const sampleEvents = [
                {
                    date: '2024-12-20',
                    title: 'Winter Break Begins',
                    description: 'Last day of school before winter break',
                    category: 'school'
                },
                {
                    date: '2025-01-06',
                    title: 'Classes Resume',
                    description: 'First day back from winter break',
                    category: 'school'
                },
                {
                    date: '2025-01-20',
                    title: 'MLK Day - No School',
                    description: 'Martin Luther King Jr. Day holiday',
                    category: 'school'
                },
                {
                    date: '2025-02-14',
                    title: 'Valentine\'s Day Dance',
                    description: 'Freshman Valentine\'s Dance in the gym',
                    category: 'social'
                },
                {
                    date: '2025-03-15',
                    title: 'Spring Break',
                    description: 'Spring break begins - have fun!',
                    category: 'school'
                }
            ];
            
            // Add sample events to the list
            sampleEvents.forEach(event => {
                const eventDate = new Date(event.date);
                if (eventDate >= today) {
                    allEvents.push(event);
                }
            });
            
            // Sort events by date
            allEvents.sort((a, b) => new Date(a.date) - new Date(b.date));
            
            eventsList.innerHTML = '';
            
            if (allEvents.length === 0) {
                eventsList.innerHTML = '<p style="color: #666; text-align: center; padding: 2rem;">No upcoming events yet. Check back soon! 📅</p>';
                return;
            }
            
            allEvents.forEach(event => {
                const eventItem = document.createElement('div');
                eventItem.className = 'event-item';
                
                const eventDate = new Date(event.date);
                const formattedDate = eventDate.toLocaleDateString('en-US', {
                    weekday: 'long',
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });
                
                // Get category info
                const categoryEmojis = {
                    academic: '📚',
                    social: '🎉',
                    sports: '🏆',
                    club: '🎭',
                    school: '🏫',
                    'spirit-week': '🌟',
                    other: '📝'
                };
                
                const categoryEmoji = categoryEmojis[event.category] || '📝';
                const sportConfig = event.sportsType ? SPORTS_CONFIG[event.sportsType] : null;
                
                let eventTitle = event.title;
                if (sportConfig) {
                    eventTitle = `${sportConfig.emoji} ${sportConfig.name} - ${event.title}`;
                } else if (event.category === 'spirit-week' && event.spiritTheme && SPIRIT_THEMES[event.spiritTheme]) {
                    const themeConfig = SPIRIT_THEMES[event.spiritTheme];
                    eventTitle = `${themeConfig.emoji} ${themeConfig.name}`;
                }
                
                let scoreDisplay = '';
                if (event.score) {
                    const resultEmoji = event.result === 'W' ? '🎉' : event.result === 'L' ? '😔' : '🤝';
                    scoreDisplay = `
                        <div style="background: ${event.result === 'W' ? '#e8f5e8' : event.result === 'L' ? '#ffe8e8' : '#f0f0f0'}; padding: 0.8rem; border-radius: 8px; margin-top: 0.5rem; border: 2px solid ${event.result === 'W' ? '#1a5f1a' : event.result === 'L' ? '#cc0000' : '#999'}; font-size: 0.9rem;">
                            <strong>${resultEmoji} Final Score:</strong> Sehome ${event.score.sehome} - ${event.opponent || 'Opponent'} ${event.score.opponent}
                        </div>
                    `;
                }
                
                eventItem.innerHTML = `
                    <div class="event-date">${formattedDate} ${event.time ? `at ${event.time}` : ''}</div>
                    <div class="event-title">${categoryEmoji} ${eventTitle}</div>
                    ${event.opponent ? `<div class="event-description"><strong>vs ${event.opponent}</strong></div>` : ''}
                    ${event.location ? `<div class="event-description">📍 ${event.location}</div>` : ''}
                    ${event.description ? `<div class="event-description">${event.description}</div>` : ''}
                    ${scoreDisplay}
                `;
                
                eventsList.appendChild(eventItem);
            });
        }

        function submitSuggestion(e) {
            e.preventDefault();
            
            // Add enhanced animation to submit button
            const submitBtn = e.target.querySelector('button[type="submit"]');
            if (submitBtn) {
                submitBtn.classList.add('rubber-band');
                setTimeout(() => submitBtn.classList.remove('rubber-band'), 1000);
            }
            
            const suggestion = {
                id: Date.now(),
                text: document.getElementById('suggestionText').value,
                date: new Date().toLocaleDateString()
            };
            
            suggestions.push(suggestion);
            localStorage.setItem('sehomeSuggestions', JSON.stringify(suggestions));
            
            // Clear form with enhanced animation
            const textArea = document.getElementById('suggestionText');
            textArea.classList.add('slide-in-up');
            textArea.style.transition = 'all 0.4s ease-out';
            textArea.style.transform = 'scale(0.9) rotateX(10deg)';
            textArea.style.opacity = '0.6';
            
            setTimeout(() => {
                textArea.value = '';
                textArea.style.transform = 'scale(1) rotateX(0deg)';
                textArea.style.opacity = '1';
                textArea.classList.remove('slide-in-up');
            }, 400);
            
            renderSuggestionsList();
            showNotification('💡 Thank you for your anonymous suggestion! Only class representatives can view it.');
        }

        // Enhanced Admin Security Functions
        function showPasscodeModal() {
            if (isAdminAuthenticated) {
                toggleAdminPanel();
                return;
            }
            
            if (isLockedOut()) {
                showLockoutMessage();
                return;
            }
            
            const modal = document.getElementById('passcodeModal');
            modal.style.display = 'flex';
            resetModalState();
            document.getElementById('passcodeInput').focus();
            updateAttemptCounter();
        }

        function closeSecurityModal() {
            const modal = document.getElementById('passcodeModal');
            modal.style.display = 'none';
            resetModalState();
        }

        function resetModalState() {
            document.getElementById('passcodeStep').style.display = 'block';
            document.getElementById('securityStep').style.display = 'none';
            document.getElementById('lockoutMessage').style.display = 'none';
            document.getElementById('passcodeInput').value = '';
            document.getElementById('securityAnswer').value = '';
            document.getElementById('errorMessage').innerHTML = '';
            currentSecurityStep = null;
            currentStepIndex = 0;
        }

        function updateAttemptCounter() {
            document.getElementById('attemptCounter').textContent = loginAttempts;
        }

        function checkPasscode() {
            if (isLockedOut()) {
                showLockoutMessage();
                return;
            }
            
            const input = document.getElementById('passcodeInput').value;
            const errorDiv = document.getElementById('errorMessage');
            
            if (input === ADMIN_PASSCODE) {
                // Proceed to security steps
                currentStepIndex = 0;
                showSecurityStep();
            } else {
                loginAttempts++;
                updateAttemptCounter();
                
                if (loginAttempts >= 3) {
                    lockAccount();
                    showLockoutMessage();
                } else {
                    errorDiv.innerHTML = `<div style="color: #ff4444; font-weight: bold;">❌ Incorrect passcode! ${3 - loginAttempts} attempts remaining.</div>`;
                    document.getElementById('passcodeInput').value = '';
                }
            }
        }

        function showSecurityStep() {
            currentSecurityStep = getNextSecurityStep();
            if (!currentSecurityStep) {
                // All steps completed
                authenticateAdmin();
                return;
            }
            
            // Update step counter
            document.getElementById('stepCounter').textContent = `Step 2 of 2: Security Verification`;
            
            document.getElementById('securityQuestion').textContent = currentSecurityStep.prompt;
            document.getElementById('securityAnswer').placeholder = currentSecurityStep.placeholder;
            
            // Set input type based on step type
            const answerInput = document.getElementById('securityAnswer');
            if (currentSecurityStep.type === 'code') {
                answerInput.type = 'password';
                answerInput.maxLength = 4;
            } else {
                answerInput.type = 'text';
                answerInput.maxLength = 50;
            }
            
            document.getElementById('passcodeStep').style.display = 'none';
            document.getElementById('securityStep').style.display = 'block';
            document.getElementById('securityAnswer').focus();
        }

        function checkSecurityAnswer() {
            const answer = document.getElementById('securityAnswer').value.toLowerCase().trim();
            const correctAnswer = currentSecurityStep.answer.toLowerCase();
            const errorDiv = document.getElementById('errorMessage');
            
            if (answer === correctAnswer) {
                // Move to next step
                currentStepIndex++;
                document.getElementById('securityAnswer').value = '';
                document.getElementById('errorMessage').innerHTML = '';
                
                if (currentStepIndex >= SECURITY_STEPS.length) {
                    // All steps completed - authenticate
                    authenticateAdmin();
                } else {
                    // Show next security step
                    showSecurityStep();
                }
            } else {
                loginAttempts++;
                updateAttemptCounter();
                
                if (loginAttempts >= 3) {
                    lockAccount();
                    showLockoutMessage();
                } else {
                    errorDiv.innerHTML = `<div style="color: #ff4444; font-weight: bold;">❌ Incorrect! ${3 - loginAttempts} attempts remaining.</div>`;
                    document.getElementById('securityAnswer').value = '';
                }
            }
        }
        
        function authenticateAdmin() {
            isAdminAuthenticated = true;
            loginAttempts = 0; // Reset attempts on successful login
            closeSecurityModal();
            toggleAdminPanel();
            resetSession(); // Start session timer
            
            document.querySelector('.admin-btn').textContent = '🔓 Representative Dashboard';
            showNotification('✅ Representative access granted! All security steps completed. Session will expire in 15 minutes for security.');
            logAdminActivity('Admin authenticated successfully');
        }

        function backToPasscode() {
            document.getElementById('securityStep').style.display = 'none';
            document.getElementById('passcodeStep').style.display = 'block';
            document.getElementById('passcodeInput').focus();
            document.getElementById('errorMessage').innerHTML = '';
        }

        function showLockoutMessage() {
            const modal = document.getElementById('passcodeModal');
            modal.style.display = 'flex';
            document.getElementById('passcodeStep').style.display = 'none';
            document.getElementById('securityStep').style.display = 'none';
            document.getElementById('lockoutMessage').style.display = 'block';
            
            updateLockoutTimer();
        }

        function updateLockoutTimer() {
            const timer = document.getElementById('lockoutTimer');
            if (!timer) return;
            
            const remaining = Math.max(0, lockoutTime - Date.now());
            const minutes = Math.floor(remaining / 60000);
            const seconds = Math.floor((remaining % 60000) / 1000);
            
            timer.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
            
            if (remaining > 0) {
                setTimeout(updateLockoutTimer, 1000);
            } else {
                closeSecurityModal();
            }
        }

        function toggleAdminPanel() {
            const panel = document.getElementById('adminPanel');
            if (panel.style.display === 'none' || panel.style.display === '') {
                panel.style.display = 'block';
                panel.style.opacity = '0';
                panel.style.transform = 'translateY(30px)';
                
                // Animate in
                setTimeout(() => {
                    panel.style.transition = 'all 0.5s ease-out';
                    panel.style.opacity = '1';
                    panel.style.transform = 'translateY(0)';
                }, 10);
                
                renderAnnouncementsList();
                renderSuggestionsList();
                renderSpotlightList();
                updateAnalytics();
                logAdminActivity('Admin panel opened');
                

            } else {
                // Animate out
                panel.style.transition = 'all 0.3s ease-in';
                panel.style.opacity = '0';
                panel.style.transform = 'translateY(-20px)';
                
                setTimeout(() => {
                    panel.style.display = 'none';
                }, 300);
                
                logAdminActivity('Admin panel closed');
            }
        }

        function logoutAdmin() {
            if (confirm('Are you sure you want to logout?')) {
                isAdminAuthenticated = false;
                if (sessionTimeout) clearTimeout(sessionTimeout);
                
                // Hide admin panel with animation
                const panel = document.getElementById('adminPanel');
                panel.style.transition = 'all 0.3s ease-in';
                panel.style.opacity = '0';
                panel.style.transform = 'translateY(-20px)';
                
                setTimeout(() => {
                    panel.style.display = 'none';
                    panel.style.opacity = '';
                    panel.style.transform = '';
                    panel.style.transition = '';
                }, 300);
                
                // Reset admin button text
                document.querySelector('.admin-btn').textContent = '🔐 Representative Access';
                

                
                logAdminActivity('Admin logged out');
                showNotification('🔒 Successfully logged out!');
            }
        }

        function logAdminActivity(action) {
            const timestamp = new Date().toLocaleString();
            const logs = JSON.parse(localStorage.getItem('adminLogs')) || [];
            logs.push({ action, timestamp });
            
            // Keep only last 50 logs
            if (logs.length > 50) {
                logs.splice(0, logs.length - 50);
            }
            
            localStorage.setItem('adminLogs', JSON.stringify(logs));
        }

        function showAdminTab(tabName) {
            // Hide all admin content
            document.querySelectorAll('.admin-content').forEach(content => {
                content.classList.remove('active');
            });
            
            // Remove active class from all tabs
            document.querySelectorAll('.admin-tab').forEach(tab => {
                tab.classList.remove('active');
            });
            
            // Show selected content and activate tab
            document.getElementById(tabName + 'Tab').classList.add('active');
            document.querySelector(`[onclick="showAdminTab('${tabName}')"]`).classList.add('active');
        }

        // Global variables for delete confirmation
        let pendingDeleteEventId = null;
        let pendingDeleteDateKey = null;
        let pendingDeleteType = null;
        let pendingDeleteId = null;

        // Unified delete confirmation modal
        function showDeleteConfirmationModal(type, id, title) {
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            pendingDeleteType = type;
            pendingDeleteId = id;
            
            const modal = document.getElementById('deleteConfirmationModal');
            const textElement = document.getElementById('deleteConfirmationText');
            
            let message = '';
            switch(type) {
                case 'announcement':
                    message = `Are you sure you want to delete the announcement "${title}"?`;
                    break;
                case 'suggestion':
                    message = `Are you sure you want to delete ${title}?`;
                    break;
                case 'spotlight':
                    message = `Remove ${title} from class representatives?`;
                    break;
                default:
                    message = `Are you sure you want to delete "${title}"?`;
            }
            
            textElement.textContent = message + ' This action cannot be undone.';
            modal.style.display = 'flex';
        }

        // Show delete confirmation modal for events (legacy support)
        function showDeleteConfirmation(eventId, dateKey, eventTitle) {
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            pendingDeleteEventId = eventId;
            pendingDeleteDateKey = dateKey;
            pendingDeleteType = 'event';
            
            const modal = document.getElementById('deleteConfirmationModal');
            const textElement = document.getElementById('deleteConfirmationText');
            
            textElement.textContent = `Are you sure you want to delete "${eventTitle}"? This action cannot be undone.`;
            modal.style.display = 'flex';
        }

        // Confirm deletion based on type
        function confirmEventDeletion() {
            if (pendingDeleteType === 'event') {
                confirmEventDeletionLogic();
            } else if (pendingDeleteType === 'announcement') {
                confirmAnnouncementDeletion();
            } else if (pendingDeleteType === 'suggestion') {
                confirmSuggestionDeletion();
            } else if (pendingDeleteType === 'spotlight') {
                confirmSpotlightDeletion();
            }
        }

        // Event deletion logic
        function confirmEventDeletionLogic() {
            if (!pendingDeleteEventId || !pendingDeleteDateKey) {
                cancelEventDeletion();
                return;
            }
            
            // Make sure we have events for this date
            if (!events[pendingDeleteDateKey] || !Array.isArray(events[pendingDeleteDateKey])) {
                showNotification('Event not found!', 'error');
                cancelEventDeletion();
                return;
            }
            
            // Find the event by ID
            const eventIndex = events[pendingDeleteDateKey].findIndex(event => {
                return String(event.id) === String(pendingDeleteEventId) || Number(event.id) === Number(pendingDeleteEventId);
            });
            
            if (eventIndex === -1) {
                showNotification('Event not found!', 'error');
                cancelEventDeletion();
                return;
            }
            
            const eventToDelete = events[pendingDeleteDateKey][eventIndex];
            
            // Remove the event using splice
            events[pendingDeleteDateKey].splice(eventIndex, 1);
            
            // If no events left for this date, remove the date key
            if (events[pendingDeleteDateKey].length === 0) {
                delete events[pendingDeleteDateKey];
            }
            
            // Save to localStorage
            localStorage.setItem('sehomeEvents', JSON.stringify(events));
            
            // Close modal and clear pending data
            cancelEventDeletion();
            
            // Force immediate re-render
            renderCalendar();
            renderEventsList();
            renderAdminEventsList();
            if (isAdminAuthenticated) {
                renderPendingGames();
            }
            updateAnalytics();
            
            logAdminActivity(`Deleted event: ${eventToDelete.title}`);
            resetSession();
            showNotification('🗑️ Event deleted successfully!');
        }

        // Announcement deletion logic
        function confirmAnnouncementDeletion() {
            const announcementIndex = announcements.findIndex(ann => {
                return String(ann.id) === String(pendingDeleteId) || Number(ann.id) === Number(pendingDeleteId);
            });
            
            if (announcementIndex === -1) {
                showNotification('Announcement not found!', 'error');
                cancelEventDeletion();
                return;
            }
            
            const announcementToDelete = announcements[announcementIndex];
            
            // Remove using splice
            announcements.splice(announcementIndex, 1);
            
            // Save to localStorage
            localStorage.setItem('sehomeAnnouncements', JSON.stringify(announcements));
            
            // Close modal and clear pending data
            cancelEventDeletion();
            
            // Force immediate re-render
            renderAnnouncementsList();
            renderPublicAnnouncements();
            updateAnalytics();
            
            logAdminActivity(`Deleted announcement: ${announcementToDelete.title}`);
            resetSession();
            showNotification('🗑️ Announcement deleted successfully!');
        }

        // Suggestion deletion logic
        function confirmSuggestionDeletion() {
            const suggestionIndex = suggestions.findIndex(sug => {
                return String(sug.id) === String(pendingDeleteId) || Number(sug.id) === Number(pendingDeleteId);
            });
            
            if (suggestionIndex === -1) {
                showNotification('Suggestion not found!', 'error');
                cancelEventDeletion();
                return;
            }
            
            // Remove using splice
            suggestions.splice(suggestionIndex, 1);
            
            // Save to localStorage
            localStorage.setItem('sehomeSuggestions', JSON.stringify(suggestions));
            
            // Close modal and clear pending data
            cancelEventDeletion();
            
            // Force immediate re-render
            renderSuggestionsList();
            updateAnalytics();
            
            logAdminActivity('Deleted a student suggestion');
            resetSession();
            showNotification('🗑️ Suggestion deleted successfully!');
        }

        // Spotlight deletion logic
        function confirmSpotlightDeletion() {
            const repIndex = classReps.findIndex(rep => {
                return String(rep.id) === String(pendingDeleteId) || Number(rep.id) === Number(pendingDeleteId);
            });
            
            if (repIndex === -1) {
                showNotification('Representative not found!', 'error');
                cancelEventDeletion();
                return;
            }
            
            const repToDelete = classReps[repIndex];
            
            // Remove using splice
            classReps.splice(repIndex, 1);
            
            // Save to localStorage
            localStorage.setItem('sehomeClassReps', JSON.stringify(classReps));
            
            // Close modal and clear pending data
            cancelEventDeletion();
            
            // Force immediate re-render
            renderSpotlightList();
            renderPublicSpotlights();
            updateAnalytics();
            
            logAdminActivity(`Removed ${repToDelete.name} from class representatives`);
            resetSession();
            showNotification('👑 Representative removed!');
        }

        // Cancel deletion
        function cancelEventDeletion() {
            const modal = document.getElementById('deleteConfirmationModal');
            modal.style.display = 'none';
            pendingDeleteEventId = null;
            pendingDeleteDateKey = null;
            pendingDeleteType = null;
            pendingDeleteId = null;
        }

        // Legacy delete function (kept for admin panel buttons)
        function deleteEvent(eventId, dateKey) {
            showDeleteConfirmation(eventId, dateKey, 'this event');
        }

        // Global variables for delete confirmation
        let pendingDeleteAnnouncementId = null;
        let pendingDeleteSuggestionId = null;
        let pendingDeleteSpotlightId = null;

        function deleteAnnouncement(id) {
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            const announcement = announcements.find(ann => String(ann.id) === String(id) || Number(ann.id) === Number(id));
            if (!announcement) {
                showNotification('Announcement not found!', 'error');
                return;
            }
            
            showDeleteConfirmationModal('announcement', id, announcement.title);
        }

        function deleteSuggestion(id) {
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            const suggestion = suggestions.find(sug => String(sug.id) === String(id) || Number(sug.id) === Number(id));
            if (!suggestion) {
                showNotification('Suggestion not found!', 'error');
                return;
            }
            
            showDeleteConfirmationModal('suggestion', id, 'this suggestion');
        }

        function deleteSpotlight(id) {
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            const rep = classReps.find(rep => String(rep.id) === String(id) || Number(rep.id) === Number(id));
            if (!rep) {
                showNotification('Representative not found!', 'error');
                return;
            }
            
            showDeleteConfirmationModal('spotlight', id, rep.name);
        }

