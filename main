                        </div>
                        
                        <div class="form-group" style="margin-bottom: 2rem;">
                            <label style="color: #1a5f1a; font-weight: bold; margin-bottom: 0.5rem; display: block;">Total Class Size:</label>
                            <input type="number" id="totalClassSize" min="1" max="500" placeholder="Total number of students in class" style="width: 100%; padding: 1rem; border: 2px solid #ffd700; border-radius: 10px; font-size: 1rem;" required>
                        </div>
                        
                        <div style="text-align: center; display: flex; gap: 1rem; justify-content: center;">
                            <button type="submit" class="action-btn" style="background: linear-gradient(45deg, #1a5f1a, #2d4a2d);">📋 Record Attendance</button>
                            <button type="button" class="action-btn" onclick="this.closest('.bulk-modal').remove()">Cancel</button>
                        </div>
                    </form>
                    
                    <div id="attendanceHistory" style="margin-top: 2rem; max-height: 300px; overflow-y: auto;">
                        ${renderAttendanceHistory()}
                    </div>
                </div>
            `;
            
            document.body.appendChild(modal);
            
            // Set today's date as default
            document.getElementById('attendanceDate').value = new Date().toISOString().split('T')[0];
        }

        function recordAttendance(e, modal) {
            e.preventDefault();
            
            const eventName = document.getElementById('attendanceEvent').value;
            const date = document.getElementById('attendanceDate').value;
            const present = parseInt(document.getElementById('studentsPresent').value);
            const total = parseInt(document.getElementById('totalClassSize').value);
            
            if (present > total) {
                showNotification('Students present cannot exceed total class size!', 'error');
                return;
            }
            
            const attendanceRecord = {
                id: Date.now(),
                event: eventName,
                date: date,
                present: present,
                total: total,
                percentage: Math.round((present / total) * 100),
                recordedBy: 'admin',
                recordedAt: new Date().toISOString()
            };
            
            let attendanceData = JSON.parse(localStorage.getItem('attendanceData')) || [];
            attendanceData.unshift(attendanceRecord);
            localStorage.setItem('attendanceData', JSON.stringify(attendanceData));
            
            modal.remove();
            logAdminActivity(`Recorded attendance: ${eventName} - ${present}/${total} students (${attendanceRecord.percentage}%)`);
            showNotification(`📋 Attendance recorded: ${present}/${total} students (${attendanceRecord.percentage}%)`);
        }

        function renderAttendanceHistory() {
            const attendanceData = JSON.parse(localStorage.getItem('attendanceData')) || [];
            
            if (attendanceData.length === 0) {
                return '<p style="color: #666; text-align: center; padding: 1rem;">No attendance records yet.</p>';
            }
            
            let history = '<h4 style="color: #1a5f1a; margin-bottom: 1rem;">📊 Recent Attendance</h4>';
            
            attendanceData.slice(0, 5).forEach(record => {
                const percentage = record.percentage;
                const color = percentage >= 80 ? '#1a5f1a' : percentage >= 60 ? '#ff8800' : '#cc0000';
                
                history += `
                    <div style="background: rgba(255, 255, 255, 0.9); border: 2px solid #ffd700; border-radius: 10px; padding: 1rem; margin-bottom: 0.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <strong style="color: #1a5f1a;">${record.event}</strong>
                                <div style="color: #666; font-size: 0.9rem;">${new Date(record.date).toLocaleDateString()}</div>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-size: 1.2rem; font-weight: bold; color: ${color};">${percentage}%</div>
                                <div style="color: #666; font-size: 0.9rem;">${record.present}/${record.total}</div>
                            </div>
                        </div>
                    </div>
                `;
            });
            
            return history;
        }

        // Grade Tracking Functions
        function showGradeTracker() {
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            const modal = document.createElement('div');
            modal.className = 'bulk-modal';
