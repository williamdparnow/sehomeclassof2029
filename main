        function sendMoodBooster(type) {
            const moodBoosters = {
                motivational: [
                    "💪 You're capable of amazing things! Keep pushing forward, Class of 2029!",
                    "🌟 Every challenge is an opportunity to grow stronger. You've got this!",
                    "🚀 Your potential is limitless! Dream big and work hard!",
                    "💎 Diamonds are formed under pressure - and so are champions like you!",
                    "🏆 Success isn't just about grades - it's about the person you're becoming!"
                ],
                funfact: [
                    "🤓 Did you know? The human brain has about 86 billion neurons - that's more than the number of stars in the Milky Way!",
                    "🐙 Fun fact: Octopuses have three hearts and blue blood! Nature is amazing!",
                    "🍯 Honey never spoils! Archaeologists have found 3000-year-old honey that's still edible!",
                    "🦋 A group of flamingos is called a 'flamboyance' - how perfect is that?",
                    "🌈 There are more possible games of chess than atoms in the observable universe!"
                ],
                joke: [
                    "😂 Why don't scientists trust atoms? Because they make up everything!",
                    "🤣 What do you call a bear with no teeth? A gummy bear!",
                    "😄 Why did the math book look so sad? Because it had too many problems!",
                    "😆 What's the best thing about Switzerland? I don't know, but the flag is a big plus!",
                    "🤪 Why don't eggs tell jokes? They'd crack each other up!"
                ],
                achievement: [
                    "🏆 Amazing job on your recent test scores, Class of 2029! Your hard work is paying off!",
                    "🎉 Shoutout to everyone who participated in spirit week - you showed incredible school pride!",
                    "👏 Your class has the highest attendance rate this month - way to show up!",
                    "🌟 Teachers are raving about your positive attitudes and teamwork!",
                    "💚 You've raised over $500 for charity this semester - you're making a real difference!"
                ]
            };
            
            const messages = moodBoosters[type];
            const randomMessage = messages[Math.floor(Math.random() * messages.length)];
            
            displayMoodBooster(randomMessage);
            closeMoodBoosterModal();
            
            logAdminActivity(`Sent ${type} mood booster`);
            resetSession();
            showNotification('😊 Mood booster sent to all students!');
        }

        function sendCustomMoodBooster(e) {
            e.preventDefault();
            
            const message = document.getElementById('customMoodMessage').value;
            if (!message.trim()) return;
            
            displayMoodBooster(`💝 ${message}`);
            closeMoodBoosterModal();
            
            logAdminActivity('Sent custom mood booster');
            resetSession();
            showNotification('😊 Custom mood booster sent!');
        }

        function displayMoodBooster(message) {
            // Add to mood boosters array
            const moodBooster = {
                id: Date.now(),
                message: message,
                date: new Date().toISOString(),
                expires: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString() // 24 hours
            };
            
            moodBoosters.unshift(moodBooster);
            localStorage.setItem('moodBoosters', JSON.stringify(moodBoosters));
            
            // Display in announcements section
            renderPublicAnnouncements();
        }

        // Student Poll Functions
        function showStudentPollModal() {
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            document.getElementById('studentPollModal').style.display = 'flex';
            document.getElementById('pollQuestion').focus();
        }

        function closeStudentPollModal() {
            document.getElementById('studentPollModal').style.display = 'none';
            document.getElementById('pollQuestion').value = '';
            document.getElementById('pollOption1').value = '';
            document.getElementById('pollOption2').value = '';
            document.getElementById('pollOption3').value = '';
            document.getElementById('pollOption4').value = '';
            document.getElementById('pollDuration').value = '3';
        }

        function createStudentPoll(e) {
            e.preventDefault();
            
            const question = document.getElementById('pollQuestion').value;
            const option1 = document.getElementById('pollOption1').value;
            const option2 = document.getElementById('pollOption2').value;
            const option3 = document.getElementById('pollOption3').value;
            const option4 = document.getElementById('pollOption4').value;
            const duration = parseInt(document.getElementById('pollDuration').value);
            
            const options = [option1, option2];
            if (option3.trim()) options.push(option3);
            if (option4.trim()) options.push(option4);
            
            const poll = {
                id: Date.now(),
                question: question,
                options: options.map(opt => ({ text: opt, votes: 0 })),
                totalVotes: 0,
                createdDate: new Date().toISOString(),
                expiresDate: new Date(Date.now() + duration * 24 * 60 * 60 * 1000).toISOString(),
                voters: [] // Track who voted to prevent duplicate votes
            };
            
            activePools.unshift(poll);
            localStorage.setItem('activePolls', JSON.stringify(activePools));
            
            renderActivePolls();
            closeStudentPollModal();
            
            logAdminActivity(`Created poll: ${question}`);
            resetSession();
            showNotification('📊 Student poll created and is now live!');
        }

        function renderActivePolls() {
            const pollsSection = document.getElementById('activePollsSection');
            const pollsList = document.getElementById('activePollsList');
            
            // Remove expired polls
            const now = new Date();
            activePools = activePools.filter(poll => new Date(poll.expiresDate) > now);
            localStorage.setItem('activePolls', JSON.stringify(activePools));
            
            if (activePools.length === 0) {
                pollsSection.style.display = 'none';
                return;
            }
            
            pollsSection.style.display = 'block';
            pollsList.innerHTML = '';
            
            activePools.forEach(poll => {
                const pollCard = document.createElement('div');
                pollCard.className = 'poll-card';
                
                const expiresDate = new Date(poll.expiresDate);
                const timeLeft = Math.ceil((expiresDate - now) / (1000 * 60 * 60 * 24));
                
                // Check if user has voted (using a simple localStorage key)
                const userVoteKey = `poll_${poll.id}_voted`;
                const hasVoted = localStorage.getItem(userVoteKey) === 'true';
                
                let pollContent = `
                    <div class="poll-question">📊 ${poll.question}</div>
                    <div style="color: #666; font-size: 0.9rem; margin-bottom: 1rem;">
                        ${poll.totalVotes} votes • ${timeLeft} day${timeLeft !== 1 ? 's' : ''} left
                    </div>
                `;
                
                if (hasVoted) {
                    // Show results
                    pollContent += '<div class="poll-results">';
                    poll.options.forEach(option => {
                        const percentage = poll.totalVotes > 0 ? Math.round((option.votes / poll.totalVotes) * 100) : 0;
                        pollContent += `
                            <div style="margin-bottom: 0.5rem;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 0.2rem;">
                                    <span>${option.text}</span>
                                    <span>${percentage}% (${option.votes})</span>
                                </div>
                                <div class="poll-result-bar">
                                    <div class="poll-result-fill" style="width: ${percentage}%"></div>
                                </div>
                            </div>
                        `;
                    });
                    pollContent += '</div>';
                } else {
                    // Show voting options
                    poll.options.forEach((option, index) => {
                        pollContent += `
                            <div class="poll-option" onclick="voteInPoll(${poll.id}, ${index})">
                                <span>${option.text}</span>
                                <span>👆 Vote</span>
                            </div>
                        `;
                    });
                }
                
                pollCard.innerHTML = pollContent;
                pollsList.appendChild(pollCard);
            });
        }

        function voteInPoll(pollId, optionIndex) {
            const userVoteKey = `poll_${pollId}_voted`;
            
            // Check if user already voted
            if (localStorage.getItem(userVoteKey) === 'true') {
                showNotification('You have already voted in this poll!', 'warning');
                return;
            }
            
            // Find the poll and update vote
            const poll = activePools.find(p => p.id === pollId);
            if (poll) {
                poll.options[optionIndex].votes++;
                poll.totalVotes++;
                
                // Mark user as voted
                localStorage.setItem(userVoteKey, 'true');
                
                // Save updated polls
                localStorage.setItem('activePolls', JSON.stringify(activePools));
                
                // Re-render polls
                renderActivePolls();
                
                showNotification('🗳️ Thank you for voting! Results updated.');
            }
        }

        // Photo Crop Functions
        let currentCropCallback = null;
        let cropImageData = null;
        let cropScale = 1;
        let cropX = 0;
        let cropY = 0;
        let isDragging = false;
        let dragStartX = 0;
        let dragStartY = 0;

        function showPhotoCropModal(file, callback) {
            currentCropCallback = callback;
            
            const reader = new FileReader();
            reader.onload = function(e) {
                cropImageData = e.target.result;
                setupCropInterface();
                document.getElementById('photoCropModal').style.display = 'flex';
            };
            reader.readAsDataURL(file);
        }

        function setupCropInterface() {
            const cropImage = document.getElementById('cropImage');
            const cropContainer = document.getElementById('cropContainer');
            
            cropImage.src = cropImageData;
            cropImage.onload = function() {
                // Calculate initial scale to fit image in container
                const containerSize = 400;
                const imageAspect = this.naturalWidth / this.naturalHeight;
                
                if (imageAspect > 1) {
                    // Landscape
                    cropScale = containerSize / this.naturalWidth;
                } else {
                    // Portrait or square
                    cropScale = containerSize / this.naturalHeight;
                }
                
                // Center the image
                resetCropPosition();
                
                // Set up drag functionality
                setupCropDragging();
            };
        }

        function setupCropDragging() {
            const cropImage = document.getElementById('cropImage');
            
            cropImage.addEventListener('mousedown', startDrag);
            cropImage.addEventListener('touchstart', startDrag);
            
            document.addEventListener('mousemove', drag);
            document.addEventListener('touchmove', drag);
            
            document.addEventListener('mouseup', endDrag);
            document.addEventListener('touchend', endDrag);
        }

        function startDrag(e) {
            isDragging = true;
            const clientX = e.clientX || e.touches[0].clientX;
            const clientY = e.clientY || e.touches[0].clientY;
            
            dragStartX = clientX - cropX;
            dragStartY = clientY - cropY;
            
            e.preventDefault();
        }

        function drag(e) {
            if (!isDragging) return;
            
            const clientX = e.clientX || e.touches[0].clientX;
            const clientY = e.clientY || e.touches[0].clientY;
            
            cropX = clientX - dragStartX;
            cropY = clientY - dragStartY;
            
            updateCropImagePosition();
            e.preventDefault();
        }

        function endDrag() {
            isDragging = false;
        }

        function updateCropImagePosition() {
            const cropImage = document.getElementById('cropImage');
            const scaledWidth = cropImage.naturalWidth * cropScale;
            const scaledHeight = cropImage.naturalHeight * cropScale;
            
            cropImage.style.width = scaledWidth + 'px';
            cropImage.style.height = scaledHeight + 'px';
            cropImage.style.left = cropX + 'px';
            cropImage.style.top = cropY + 'px';
        }

        function adjustCropZoom(delta) {
            cropScale = Math.max(0.1, Math.min(3, cropScale + delta));
            updateCropImagePosition();
        }

        function resetCropPosition() {
            const cropImage = document.getElementById('cropImage');
            const containerSize = 400;
            
            if (cropImage.naturalWidth && cropImage.naturalHeight) {
                const scaledWidth = cropImage.naturalWidth * cropScale;
                const scaledHeight = cropImage.naturalHeight * cropScale;
                
                cropX = (containerSize - scaledWidth) / 2;
                cropY = (containerSize - scaledHeight) / 2;
                
                updateCropImagePosition();
            }
        }

        function applyCrop() {
            const cropImage = document.getElementById('cropImage');
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            
            // Set canvas size to crop circle (200x200)
            const cropSize = 200;
            canvas.width = cropSize;
            canvas.height = cropSize;
            
            // Calculate crop area in original image coordinates
            const containerSize = 400;
            const cropCircleX = containerSize / 2 - cropSize / 2;
            const cropCircleY = containerSize / 2 - cropSize / 2;
            
            // Convert container coordinates to image coordinates
            const imageX = (cropCircleX - cropX) / cropScale;
            const imageY = (cropCircleY - cropY) / cropScale;
            const imageSize = cropSize / cropScale;
            
            // Create circular clipping path
            ctx.beginPath();
            ctx.arc(cropSize / 2, cropSize / 2, cropSize / 2, 0, 2 * Math.PI);
            ctx.clip();
            
            // Draw the cropped portion
            ctx.drawImage(
                cropImage,
                imageX, imageY, imageSize, imageSize,
                0, 0, cropSize, cropSize
            );
            
            // Convert to data URL and call callback
            const croppedImageData = canvas.toDataURL('image/jpeg', 0.9);
            
            if (currentCropCallback) {
                currentCropCallback(croppedImageData);
            }
            
            closeCropModal();
        }

        function closeCropModal() {
            document.getElementById('photoCropModal').style.display = 'none';
            currentCropCallback = null;
            cropImageData = null;
            cropScale = 1;
            cropX = 0;
            cropY = 0;
        }

        // New Admin Hover Delete System
        function setupAdminEventHover(eventElement, event, dateKey) {
            let deleteBox = null;
            let hoverTimeout = null;
            
            eventElement.addEventListener('mouseenter', () => {
                hoverTimeout = setTimeout(() => {
                    if (!deleteBox) {
                        deleteBox = document.createElement('div');
                        deleteBox.className = 'admin-delete-box';
                        deleteBox.textContent = '🗑️ Delete';
                        deleteBox.onclick = (e) => {
                            e.stopPropagation();
                            showDeleteConfirmation(event.id, dateKey, event.title);
                        };
                        eventElement.appendChild(deleteBox);
                        
                        setTimeout(() => {
                            if (deleteBox) deleteBox.classList.add('show');
                        }, 10);
                    }
                }, 500); // Show after 0.5 seconds of hover
            });
            
            eventElement.addEventListener('mouseleave', () => {
                if (hoverTimeout) {
                    clearTimeout(hoverTimeout);
                    hoverTimeout = null;
                }
                
                if (deleteBox) {
                    deleteBox.classList.remove('show');
                    setTimeout(() => {
                        if (deleteBox && deleteBox.parentNode) {
                            deleteBox.parentNode.removeChild(deleteBox);
                            deleteBox = null;
                        }
                    }, 300);
                }
            });
        }

        // Attendance Tracking Functions
        function showAttendanceTracker() {
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            const modal = document.createElement('div');
