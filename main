                            <button type="submit" class="action-btn" style="background: linear-gradient(45deg, #1a5f1a, #2d4a2d);">📊 Record Grades</button>
                            <button type="button" class="action-btn" onclick="this.closest('.bulk-modal').remove()">Cancel</button>
                        </div>
                    </form>
                    
                    <div id="gradeHistory" style="margin-top: 2rem; max-height: 300px; overflow-y: auto;">
                        ${renderGradeHistory()}
                    </div>
                </div>
            `;
            
            document.body.appendChild(modal);
            
            // Set today's date as default
            document.getElementById('gradeDate').value = new Date().toISOString().split('T')[0];
        }

        function recordGradeData(e, modal) {
            e.preventDefault();
            
            const subject = document.getElementById('gradeSubject').value;
            const average = parseFloat(document.getElementById('classAverage').value);
            const above90 = parseInt(document.getElementById('studentsAbove90').value);
            const date = document.getElementById('gradeDate').value;
            
            const gradeRecord = {
                id: Date.now(),
                subject: subject,
                average: average,
                above90: above90,
                date: date,
                letterGrade: getLetterGrade(average),
                recordedBy: 'admin',
                recordedAt: new Date().toISOString()
            };
            
            let gradeData = JSON.parse(localStorage.getItem('gradeData')) || [];
            gradeData.unshift(gradeRecord);
            localStorage.setItem('gradeData', JSON.stringify(gradeData));
            
            modal.remove();
            logAdminActivity(`Recorded grades: ${subject} - Class average ${average}% (${gradeRecord.letterGrade})`);
            showNotification(`📊 Grade data recorded: ${subject} - ${average}% average (${gradeRecord.letterGrade})`);
        }

        function getLetterGrade(percentage) {
            if (percentage >= 97) return 'A+';
            if (percentage >= 93) return 'A';
            if (percentage >= 90) return 'A-';
            if (percentage >= 87) return 'B+';
            if (percentage >= 83) return 'B';
            if (percentage >= 80) return 'B-';
            if (percentage >= 77) return 'C+';
            if (percentage >= 73) return 'C';
            if (percentage >= 70) return 'C-';
            if (percentage >= 67) return 'D+';
            if (percentage >= 63) return 'D';
            if (percentage >= 60) return 'D-';
            return 'F';
        }

        function renderGradeHistory() {
            const gradeData = JSON.parse(localStorage.getItem('gradeData')) || [];
            
            if (gradeData.length === 0) {
                return '<p style="color: #666; text-align: center; padding: 1rem;">No grade records yet.</p>';
            }
            
            let history = '<h4 style="color: #1a5f1a; margin-bottom: 1rem;">📈 Recent Grades</h4>';
            
            gradeData.slice(0, 5).forEach(record => {
                const gradeColor = record.average >= 90 ? '#1a5f1a' : record.average >= 80 ? '#ff8800' : record.average >= 70 ? '#ffaa00' : '#cc0000';
                
                history += `
                    <div style="background: rgba(255, 255, 255, 0.9); border: 2px solid #ffd700; border-radius: 10px; padding: 1rem; margin-bottom: 0.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <strong style="color: #1a5f1a;">${record.subject}</strong>
                                <div style="color: #666; font-size: 0.9rem;">${new Date(record.date).toLocaleDateString()}</div>
                                <div style="color: #666; font-size: 0.9rem;">${record.above90} students with A's</div>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-size: 1.2rem; font-weight: bold; color: ${gradeColor};">${record.average}%</div>
                                <div style="color: ${gradeColor}; font-weight: bold;">${record.letterGrade}</div>
                            </div>
                        </div>
                    </div>
                `;
            });
            
            return history;
        }

        // Event Reminder Functions
        function showEventReminders() {
