        function showBulkActions() {
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            document.getElementById('bulkModal').style.display = 'flex';
        }

        function closeBulkModal() {
            document.getElementById('bulkModal').style.display = 'none';
        }

        function exportAllData() {
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            const allData = {
                events: events,
                announcements: announcements,
                suggestions: suggestions,
                classReps: classReps,
                exportDate: new Date().toISOString()
            };
            
            const dataStr = JSON.stringify(allData, null, 2);
            const dataBlob = new Blob([dataStr], {type: 'application/json'});
            const url = URL.createObjectURL(dataBlob);
            
            const link = document.createElement('a');
            link.href = url;
            link.download = `sehome-class-2029-data-${new Date().toISOString().split('T')[0]}.json`;
            link.click();
            
            URL.revokeObjectURL(url);
            
            logAdminActivity('Exported all site data');
            showNotification('📊 Data exported successfully!');
        }

        // Bulk Action Functions
        function bulkDeleteOldEvents() {
            if (!confirm('Delete all events older than 30 days?')) return;
            
            const thirtyDaysAgo = new Date();
            thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
            
            let deletedCount = 0;
            Object.keys(events).forEach(dateKey => {
                const eventDate = new Date(dateKey);
                if (eventDate < thirtyDaysAgo) {
                    delete events[dateKey];
                    deletedCount++;
                }
            });
            
            localStorage.setItem('sehomeEvents', JSON.stringify(events));
            renderCalendar();
            renderEventsList();
            renderAdminEventsList();
            updateAnalytics();
            
            closeBulkModal();
            logAdminActivity(`Bulk deleted ${deletedCount} old events`);
            showNotification(`🗑️ Deleted ${deletedCount} old events!`);
        }

        function bulkDeleteAllSuggestions() {
            if (!confirm('Delete ALL student suggestions? This cannot be undone!')) return;
            
            const count = suggestions.length;
            suggestions = [];
            localStorage.setItem('sehomeSuggestions', JSON.stringify(suggestions));
            renderSuggestionsList();
            updateAnalytics();
            
            closeBulkModal();
            logAdminActivity(`Bulk deleted ${count} suggestions`);
            showNotification(`🗑️ Deleted ${count} suggestions!`);
        }

        function bulkArchiveAnnouncements() {
            if (!confirm('Archive announcements older than 14 days?')) return;
            
            const fourteenDaysAgo = new Date();
            fourteenDaysAgo.setDate(fourteenDaysAgo.getDate() - 14);
            
            const archived = announcements.filter(ann => {
                const annDate = new Date(ann.date);
                return annDate < fourteenDaysAgo;
            });
            
            announcements = announcements.filter(ann => {
                const annDate = new Date(ann.date);
                return annDate >= fourteenDaysAgo;
            });
            
            localStorage.setItem('sehomeAnnouncements', JSON.stringify(announcements));
            renderAnnouncementsList();
            updateAnalytics();
            
            closeBulkModal();
            logAdminActivity(`Bulk archived ${archived.length} old announcements`);
            showNotification(`📢 Archived ${archived.length} old announcements!`);
        }

        function bulkExportEverything() {
            exportAllData();
            closeBulkModal();
        }

        // Analytics Functions
        function updateAnalytics() {
            document.getElementById('totalSuggestions').textContent = suggestions.length;
            document.getElementById('totalEvents').textContent = Object.keys(events).reduce((total, date) => total + events[date].length, 0);
            document.getElementById('totalAnnouncements').textContent = announcements.length;
            document.getElementById('totalSpotlights').textContent = classReps.length;
            
            updateActivityLog();
        }

        function updateActivityLog() {
            const logs = JSON.parse(localStorage.getItem('adminLogs')) || [];
            const activityLog = document.getElementById('activityLog');
            
            if (logs.length === 0) {
                activityLog.innerHTML = '<p style="color: #666; text-align: center;">No activity yet.</p>';
                return;
            }
            
            activityLog.innerHTML = '';
            logs.slice(-10).reverse().forEach(log => {
                const logItem = document.createElement('div');
                logItem.style.cssText = 'padding: 0.5rem; border-bottom: 1px solid #eee; font-size: 0.9rem;';
                logItem.innerHTML = `<strong>${log.timestamp}:</strong> ${log.action}`;
                activityLog.appendChild(logItem);
            });
        }

        // Settings Functions
        function updateSecuritySettings(e) {
            e.preventDefault();
            
            const newPasscode = document.getElementById('newPasscode').value;
            const sessionTimeout = document.getElementById('sessionTimeout').value;
            
            if (newPasscode && newPasscode.length === 4) {
                // In a real app, this would be handled securely
                showNotification('🔐 Security settings updated! (Note: This is a demo - passcode remains 2029)');
            }
            
            siteSettings.sessionTimeout = parseInt(sessionTimeout);
            localStorage.setItem('siteSettings', JSON.stringify(siteSettings));
            
            logAdminActivity('Updated security settings');
            showNotification('⚙️ Settings updated successfully!');
        }

        function updateSocialSettings(e) {
            e.preventDefault();
            
            siteSettings.instagramHandle = document.getElementById('instagramHandle').value;
            siteSettings.instagramUrl = document.getElementById('instagramUrl').value;
            
            localStorage.setItem('siteSettings', JSON.stringify(siteSettings));
            
            // Update the social link
            const socialLink = document.querySelector('.social-link.instagram');
            if (socialLink) {
                socialLink.href = siteSettings.instagramUrl;
                socialLink.querySelector('.social-text').textContent = siteSettings.instagramHandle;
            }
            
            logAdminActivity('Updated social media settings');
            showNotification('🔗 Social media links updated!');
        }

        function clearOldData() {
            if (!confirm('Clear data older than 30 days? This includes old events and announcements.')) return;
            
            const thirtyDaysAgo = new Date();
            thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
            
            // Clear old events
            Object.keys(events).forEach(dateKey => {
                const eventDate = new Date(dateKey);
                if (eventDate < thirtyDaysAgo) {
                    delete events[dateKey];
                }
            });
            
            // Clear old announcements
            announcements = announcements.filter(ann => {
                const annDate = new Date(ann.date);
                return annDate >= thirtyDaysAgo;
            });
            
            localStorage.setItem('sehomeEvents', JSON.stringify(events));
            localStorage.setItem('sehomeAnnouncements', JSON.stringify(announcements));
            
            renderCalendar();
            renderEventsList();
            renderAnnouncementsList();
            updateAnalytics();
            
            logAdminActivity('Cleared old data (30+ days)');
            showNotification('🧹 Old data cleared successfully!');
        }

        function resetAllData() {
            if (!confirm('⚠️ DANGER: This will delete ALL data including events, announcements, suggestions, and spotlights. This cannot be undone! Are you absolutely sure?')) return;
            
            if (!confirm('Last chance! This will permanently delete everything. Continue?')) return;
            
            events = {};
            announcements = [];
            suggestions = [];
            classReps = [];
            
            localStorage.removeItem('sehomeEvents');
            localStorage.removeItem('sehomeAnnouncements');
            localStorage.removeItem('sehomeSuggestions');
            localStorage.removeItem('sehomeClassReps');
            localStorage.removeItem('adminLogs');
            
            renderCalendar();
            renderEventsList();
            renderAnnouncementsList();
            renderSuggestionsList();
            renderSpotlightList();
            renderPublicSpotlights();
            updateAnalytics();
            
            logAdminActivity('RESET: All data cleared');
            showNotification('⚠️ All data has been reset!', 'warning');
        }

        // Event Detail Modal Functions
        function showEventDetail(event, dateKey) {
            const modal = document.getElementById('eventDetailModal');
            const content = document.getElementById('eventDetailContent');
            
            const eventDate = new Date(dateKey);
            const formattedDate = eventDate.toLocaleDateString('en-US', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
            
            // Get category and sport info
            const categoryEmojis = {
                academic: '📚',
                social: '🎉',
                sports: '🏆',
                club: '🎭',
                school: '🏫',
                other: '📝'
            };
            
            const categoryEmoji = categoryEmojis[event.category] || '📝';
            const sportConfig = event.sportsType ? SPORTS_CONFIG[event.sportsType] : null;
            
            let eventTitle = event.title;
            let eventSubtitle = '';
            
            if (sportConfig) {
                const genderText = event.gender ? ` (${event.gender === 'boys' ? 'Boys' : 'Girls'})` : '';
                eventTitle = `${sportConfig.emoji} ${sportConfig.name}${genderText}`;
                eventSubtitle = event.title;
            } else {
                eventTitle = `${categoryEmoji} ${event.title}`;
            }
            
            // Build info cards
            let infoCards = '';
            
            // Date and Time card
            infoCards += `
                <div class="event-info-card">
                    <div class="event-info-label">📅 Date & Time</div>
                    <div class="event-info-value">${formattedDate}</div>
                    ${event.time ? `<div style="color: #666; margin-top: 0.5rem;">🕐 ${event.time}</div>` : ''}
                </div>
            `;
            
            // Location card
            if (event.location) {
                infoCards += `
                    <div class="event-info-card">
                        <div class="event-info-label">📍 Location</div>
                        <div class="event-info-value">${event.location}</div>
                    </div>
                `;
            }
            
            // Opponent card (for sports)
            if (event.opponent) {
                infoCards += `
                    <div class="event-info-card">
                        <div class="event-info-label">🆚 Opponent</div>
                        <div class="event-info-value">${event.opponent}</div>
                    </div>
                `;
            }
            
            // Category card
            infoCards += `
                <div class="event-info-card">
                    <div class="event-info-label">📂 Category</div>
                    <div class="event-info-value">${event.category.charAt(0).toUpperCase() + event.category.slice(1)}</div>
                </div>
            `;
            
            // Score display for completed sports events
            let scoreDisplay = '';
            if (event.score) {
                const resultClass = event.result === 'W' ? '' : event.result === 'L' ? 'loss' : 'tie';
                const resultEmoji = event.result === 'W' ? '🎉' : event.result === 'L' ? '😔' : '🤝';
                const resultText = event.result === 'W' ? 'VICTORY!' : event.result === 'L' ? 'LOSS' : 'TIE GAME';
                
                // Create sport-specific score display
                let scoreText = '';
                const scoringMethod = event.score.scoringMethod || 'standard';
                
                switch (scoringMethod) {
                    case 'tennis':
                        scoreText = `${event.score.sehome} - ${event.score.opponent} matches won`;
                        break;
                    case 'cross-country':
                        scoreText = `${event.score.sehome} - ${event.score.opponent} team points`;
                        break;
                    case 'golf':
                        scoreText = `${event.score.sehome} - ${event.score.opponent} total strokes`;
                        break;
                    case 'sets':
                        scoreText = `${event.score.sehome} - ${event.score.opponent} sets won`;
                        break;
                    case 'wrestling':
                    case 'track':
                        scoreText = `${event.score.sehome} - ${event.score.opponent} team points`;
                        break;
                    default:
                        scoreText = `${event.score.sehome} - ${event.score.opponent}`;
                }
                
                scoreDisplay = `
                    <div class="event-score-display ${resultClass}">
                        <div class="score-result">${resultEmoji}</div>
                        <div class="score-details">${resultText}</div>
                        <div class="score-details">Sehome ${scoreText}</div>
                        ${event.score.notes ? `<div class="score-notes">${event.score.notes}</div>` : ''}
                    </div>
                `;
            }
            
            content.innerHTML = `
                <div class="event-detail-header">
                    <div class="event-detail-title">${eventTitle}</div>
                    ${eventSubtitle ? `<div class="event-detail-subtitle">${eventSubtitle}</div>` : ''}
                </div>
                
                <div class="event-detail-info">
                    ${infoCards}
                </div>
                
                ${event.description ? `
                    <div style="background: linear-gradient(135deg, rgba(255, 215, 0, 0.1), rgba(26, 95, 26, 0.05)); padding: 1.5rem; border-radius: 15px; margin-bottom: 2rem; border: 2px solid rgba(255, 215, 0, 0.3);">
                        <h4 style="color: #1a5f1a; margin-bottom: 1rem;">📝 Description</h4>
                        <p style="color: #333; margin: 0; line-height: 1.6;">${event.description}</p>
                    </div>
                ` : ''}
                
                ${scoreDisplay}
                
                ${sportConfig ? `
                    <div style="background: linear-gradient(135deg, rgba(255, 215, 0, 0.05), rgba(26, 95, 26, 0.02)); padding: 1rem; border-radius: 10px; margin-top: 2rem; border: 1px solid rgba(255, 215, 0, 0.2); text-align: center;">
                        <small style="color: #666; font-style: italic;">${sportConfig.description}</small>
                    </div>
                ` : ''}
            `;
            
            modal.style.display = 'flex';
        }

        function closeEventDetail() {
            document.getElementById('eventDetailModal').style.display = 'none';
        }

        // Secret Access System
        let secretSequence = '';
        const SECRET_WORD = 'sehome';
        let secretTimeout = null;

        function handleSecretInput(char) {
            secretSequence += char.toLowerCase();
            
            // Clear timeout and reset if too long
            if (secretTimeout) clearTimeout(secretTimeout);
            secretTimeout = setTimeout(() => {
                secretSequence = '';
            }, 3000); // Reset after 3 seconds of no typing
            
            // Keep only the last 6 characters (length of "sehome")
            if (secretSequence.length > SECRET_WORD.length) {
                secretSequence = secretSequence.slice(-SECRET_WORD.length);
            }
            
            // Check if secret word is typed
            if (secretSequence === SECRET_WORD) {
                activateSecretAccess();
                secretSequence = ''; // Reset
            }
        }

        function activateSecretAccess() {
            const adminAccess = document.getElementById('adminAccess');
            if (adminAccess.style.display === 'none') {
                adminAccess.style.display = 'block';
                adminAccess.style.opacity = '0';
                adminAccess.style.transform = 'translateY(20px)';
                
                // Animate in
                setTimeout(() => {
                    adminAccess.style.transition = 'all 0.5s ease-out';
                    adminAccess.style.opacity = '1';
                    adminAccess.style.transform = 'translateY(0)';
                }, 10);
                
                showNotification('🔓 Secret access activated! Representative login is now available.', 'success');
                
                // Add sparkle effect to the button
                const button = adminAccess.querySelector('.admin-btn');
                button.classList.add('sparkle-animation');
                
                // Auto-hide after 5 minutes for security
                setTimeout(() => {
                    if (!isAdminAuthenticated) {
                        adminAccess.style.transition = 'all 0.3s ease-in';
                        adminAccess.style.opacity = '0';
                        adminAccess.style.transform = 'translateY(-20px)';
                        
                        setTimeout(() => {
                            adminAccess.style.display = 'none';
                            adminAccess.style.transition = '';
                            adminAccess.style.opacity = '';
                            adminAccess.style.transform = '';
                            button.style.animation = '';
                        }, 300);
                        
                        showNotification('🔒 Secret access expired for security.', 'warning');
                    }
                }, 5 * 60 * 1000); // 5 minutes
            }
        }

        // School Day Override Functions
