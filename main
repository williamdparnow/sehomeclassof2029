        // Category and Sports Handling Functions
        function handleCategoryChange() {
            const category = document.getElementById('eventCategory').value;
            const sportsGroup = document.getElementById('sportsTypeGroup');
            const genderGroup = document.getElementById('genderGroup');
            const opponentGroup = document.getElementById('opponentGroup');
            const spiritThemeGroup = document.getElementById('spiritThemeGroup');
            
            // Hide all conditional groups first
            sportsGroup.style.display = 'none';
            genderGroup.style.display = 'none';
            opponentGroup.style.display = 'none';
            spiritThemeGroup.style.display = 'none';
            
            if (category === 'sports') {
                sportsGroup.style.display = 'block';
                genderGroup.style.display = 'block';
                opponentGroup.style.display = 'block';
            } else if (category === 'spirit-week') {
                spiritThemeGroup.style.display = 'block';
            } else {
                // Clear all values when switching away
                document.getElementById('sportsType').value = '';
                document.getElementById('gender').value = '';
                document.getElementById('opponent').value = '';
                document.getElementById('spiritTheme').value = '';
            }
        }

        function handleEventTypeChange() {
            const eventType = document.getElementById('eventType').value;
            const singleDateGroup = document.getElementById('singleDateGroup');
            const startDateGroup = document.getElementById('startDateGroup');
            const endDateGroup = document.getElementById('endDateGroup');
            
            if (eventType === 'multi') {
                singleDateGroup.style.display = 'none';
                startDateGroup.style.display = 'block';
                endDateGroup.style.display = 'block';
                document.getElementById('eventDate').required = false;
                document.getElementById('eventStartDate').required = true;
                document.getElementById('eventEndDate').required = true;
            } else {
                singleDateGroup.style.display = 'block';
                startDateGroup.style.display = 'none';
                endDateGroup.style.display = 'none';
                document.getElementById('eventDate').required = true;
                document.getElementById('eventStartDate').required = false;
                document.getElementById('eventEndDate').required = false;
            }
        }

        function handleSportsTypeChange() {
            const sportsType = document.getElementById('sportsType').value;
            const genderSelect = document.getElementById('gender');
            
            if (sportsType && SPORTS_CONFIG[sportsType]) {
                const sport = SPORTS_CONFIG[sportsType];
                
                // Clear and populate gender options based on sport
                genderSelect.innerHTML = '<option value="">Select Team</option>';
                sport.genders.forEach(gender => {
                    const option = document.createElement('option');
                    option.value = gender;
                    option.textContent = gender === 'boys' ? '👦 Boys' : '👧 Girls';
                    genderSelect.appendChild(option);
                });
                
                // If only one gender available, auto-select it
                if (sport.genders.length === 1) {
                    genderSelect.value = sport.genders[0];
                }
            }
        }

        // ADMIN FUNCTIONS
        function addEvent(e) {
            e.preventDefault();
            
            if (!isAdminAuthenticated) {
                showNotification('🔒 Representative access required!', 'error');
                return;
            }
            
            // Add celebration animation to submit button
            const submitBtn = e.target.querySelector('button[type="submit"]');
            if (submitBtn) {
                submitBtn.classList.add('tada-animation');
                setTimeout(() => submitBtn.classList.remove('tada-animation'), 1000);
            }
            
            const eventType = document.getElementById('eventType').value;
            const time = document.getElementById('eventTime').value;
            const category = document.getElementById('eventCategory').value;
            const sportsType = document.getElementById('sportsType').value;
            const gender = document.getElementById('gender').value;
            const title = document.getElementById('eventTitle').value;
            const opponent = document.getElementById('opponent').value;
            const location = document.getElementById('eventLocation').value;
            const description = document.getElementById('eventDescription').value;
            const spiritTheme = document.getElementById('spiritTheme').value;
            
            let eventDates = [];
            
            if (eventType === 'multi') {
                const startDate = new Date(document.getElementById('eventStartDate').value);
                const endDate = new Date(document.getElementById('eventEndDate').value);
                
                if (startDate > endDate) {
                    showNotification('Start date must be before end date!', 'error');
                    return;
                }
                
                // Generate all dates between start and end (inclusive)
                const currentDate = new Date(startDate);
                while (currentDate <= endDate) {
                    eventDates.push(currentDate.toISOString().split('T')[0]);
                    currentDate.setDate(currentDate.getDate() + 1);
                }
            } else {
                const singleDate = document.getElementById('eventDate').value;
                eventDates.push(singleDate);
            }
            
            const baseEventId = Date.now();
            
            // Add event to each date
            eventDates.forEach((date, index) => {
                if (!events[date]) {
                    events[date] = [];
                }
                
                const newEvent = {
                    id: baseEventId + index, // Unique ID for each day
                    title: title,
                    description: description,
                    category: category,
                    sportsType: sportsType,
                    gender: gender,
                    opponent: opponent,
                    location: location,
                    time: time,
                    spiritTheme: spiritTheme,
                    status: category === 'sports' ? 'scheduled' : 'confirmed',
                    score: null,
                    isMultiDay: eventType === 'multi',
                    multiDayGroup: eventType === 'multi' ? baseEventId : null,
                    dayNumber: eventType === 'multi' ? index + 1 : null,
                    totalDays: eventType === 'multi' ? eventDates.length : null
                };
                
                events[date].push(newEvent);
            });
            
            localStorage.setItem('sehomeEvents', JSON.stringify(events));
            
            // Clear form
            document.getElementById('eventTitle').value = '';
            document.getElementById('eventDescription').value = '';
            document.getElementById('eventDate').value = '';
            document.getElementById('eventStartDate').value = '';
            document.getElementById('eventEndDate').value = '';
            document.getElementById('eventTime').value = '';
            document.getElementById('eventCategory').value = '';
            document.getElementById('eventType').value = 'single';
            document.getElementById('sportsType').value = '';
            document.getElementById('gender').value = '';
            document.getElementById('opponent').value = '';
            document.getElementById('eventLocation').value = '';
            document.getElementById('spiritTheme').value = '';
            handleCategoryChange(); // Hide conditional fields
            handleEventTypeChange(); // Reset date fields
            
            renderCalendar();
            renderEventsList();
            renderAdminEventsList();
            if (isAdminAuthenticated) {
                renderPendingGames();
            }
            
            const genderText = gender ? ` (${gender === 'boys' ? 'Boys' : 'Girls'})` : '';
            const durationText = eventType === 'multi' ? ` (${eventDates.length} days)` : '';
            logAdminActivity(`Added ${category} event: ${title}${genderText}${durationText}`);
            resetSession();
            showNotification(`✅ Event added successfully${durationText}!`);
        }

        function renderPendingGames() {
            const pendingGames = document.getElementById('pendingGames');
            
            // Find sports events that need score updates
            const sportsEvents = [];
            const today = new Date();
            
            Object.keys(events).forEach(dateKey => {
                const eventDate = new Date(dateKey);
                events[dateKey].forEach(event => {
                    if (event.category === 'sports' && eventDate <= today && !event.score) {
                        sportsEvents.push({
                            ...event,
                            date: dateKey
                        });
                    }
                });
            });
            
            if (sportsEvents.length === 0) {
                pendingGames.innerHTML = '<p style="color: #666; text-align: center; padding: 1rem;">No games need score updates.</p>';
                return;
            }
            
            pendingGames.innerHTML = '';
            sportsEvents.forEach(game => {
                const gameCard = document.createElement('div');
                gameCard.className = 'announcement-card';
                gameCard.style.marginBottom = '1rem';
                
                const sportConfig = SPORTS_CONFIG[game.sportsType] || { name: game.sportsType, emoji: '🏆' };
                const formattedDate = new Date(game.date).toLocaleDateString();
                
                gameCard.innerHTML = `
                    <div class="card-header">
                        <div class="card-title">${sportConfig.emoji} ${sportConfig.name} - ${game.title}</div>
                        <button class="action-btn" onclick="showScoreModal(${game.id}, '${game.date}')">📊 Add Score</button>
                    </div>
                    <p><strong>Date:</strong> ${formattedDate} ${game.time ? `at ${game.time}` : ''}</p>
                    ${game.opponent ? `<p><strong>Opponent:</strong> ${game.opponent}</p>` : ''}
                    ${game.location ? `<p><strong>Location:</strong> ${game.location}</p>` : ''}
                `;
                
                pendingGames.appendChild(gameCard);
            });
        }

